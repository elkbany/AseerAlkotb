@model List<AseerAlkotb.Application.Features.Publishers.Response.GetAllPublisherPaginatedResponse>

@{
    ViewData["Title"] = "Publishers Management";
}

@functions {
    string ResolveImg(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return Url.Content("~/images/default-publisher.png");
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return url;
        if (url.StartsWith("~/")) return Url.Content(url);
        if (url.StartsWith("/")) return Url.Content("~" + url);
        return Url.Content("~/" + url);
    }
}

@functions {
    string Trunc(string? s, int n = 120)
        => string.IsNullOrEmpty(s) ? "" : (s.Length <= n ? s : s.Substring(0, n) + "…");
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Publishers Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Publishers</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-purple">
                    <div class="inner">
                        <h3>@(ViewBag.TotalCount ?? 0)</h3>
                        <p>Total Publishers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Publishers List</h3>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus-circle mr-1"></i> Add New Publisher
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        @TempData["Error"]
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        @TempData["Success"]
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline">
                            <div class="input-group w-100">
                                <input type="text" name="search" class="form-control" placeholder="Search by name" value="@ViewBag.SearchTerm">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm?.ToString()))
                            {
                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary ml-2">Clear</a>
                            }
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Logo</th>
                                <th>Name</th>
                                <th>Contact Email</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="@ResolveImg(item.LogoUrl)" alt="@item.Name Logo" class="img-thumbnail" style="width:50px;" />
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.ContactEmail) ? "-" : item.ContactEmail)</td>
                                        <td title="@item.Description">@Trunc(item.Description ?? "")</td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center">No publishers found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        @{
                            // Explicitly cast and compute to int to avoid dynamic binding issues
                            int currentPage = (int)ViewBag.CurrentPage;
                            int pageSize = (int)ViewBag.PageSize;
                            int totalCount = (int)ViewBag.TotalCount;
                            int endIndex = Math.Min(currentPage * pageSize, totalCount);
                        }
                        <div class="text-muted">
                            Showing @((currentPage - 1) * pageSize + 1) to @endIndex of @totalCount entries
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = currentPage - 1, search = ViewBag.SearchTerm })">Previous</a>
                                    </li>
                                }
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min((int)ViewBag.TotalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, search = ViewBag.SearchTerm })">@i</a>
                                    </li>
                                }
                                @if (currentPage < ViewBag.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = currentPage + 1, search = ViewBag.SearchTerm })">Next</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Enable tooltips
            $('[title]').tooltip();

            // Enable DataTable for better table functionality
            $('.table').DataTable({
                "paging": false,
                "ordering": true,
                "info": false,
                "searching": false,
                "responsive": true,
                "language": {
                    "emptyTable": "No data available in table"
                }
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}