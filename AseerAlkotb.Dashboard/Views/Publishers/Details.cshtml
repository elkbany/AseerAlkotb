@model AseerAlkotb.Application.Features.Publishers.Response.GetPublisherByIdResponse

@{
    ViewData["Title"] = "Publisher Details";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@Model.Name</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/"><i class="fas fa-home"></i></a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Publishers</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="card card-outline card-primary">
                    <div class="card-body box-profile">
                        <div class="text-center position-relative mb-3">
                            <img src="@Model.LogoUrl" alt="@Model.Name Logo" class="img-fluid rounded shadow-sm" style="max-height: 250px;" />
                        </div>
                        <h3 class="profile-username text-center">@Model.Name</h3>
                        <p class="text-muted text-center">@Model.ContactEmail</p>
                    </div>
                </div>

                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Quick Actions</h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="btn-group-vertical w-100">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary text-left">
                                <i class="fas fa-edit mr-2"></i> Edit Publisher
                            </a>
                            <a asp-action="Index" class="btn btn-secondary text-left">
                                <i class="fas fa-list mr-2"></i> Back to List
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger text-left">
                                <i class="fas fa-trash mr-2"></i> Delete Publisher
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Publisher Information</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Name</dt>
                            <dd class="col-sm-9">@Model.Name</dd>

                            <dt class="col-sm-3">Contact Email</dt>
                            <dd class="col-sm-9">@Model.ContactEmail</dd>

                            <dt class="col-sm-3">Logo URL</dt>
                            <dd class="col-sm-9">@Model.LogoUrl</dd>
                        </dl>
                        <hr />
                        <div class="card card-outline card-info mb-0">
                            <div class="card-header">
                                <h3 class="card-title">Description</h3>
                            </div>
                            <div class="card-body">
                                @Model.Description
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>