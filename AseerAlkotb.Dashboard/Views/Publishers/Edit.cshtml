@model AseerAlkotb.Application.Features.Publishers.Response.UpdatePublisherResponse

@{
    ViewData["Title"] = "Edit Publisher";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Edit Publisher</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Publishers</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" enctype="multipart/form-data" id="editPublisherForm">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- LEFT: Publisher Info -->
                        <div class="col-md-8">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Publisher Information</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label">Name (Arabic)</label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label for="EnglishName" class="control-label">Name (English)</label>
                                        <input name="EnglishName" id="EnglishName" class="form-control" placeholder="Enter English name" />
                                        <small class="form-text text-muted">If left empty, Arabic name will be used</small>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Description" class="control-label">Description (Arabic)</label>
                                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label for="EnglishDescription" class="control-label">Description (English)</label>
                                        <textarea name="EnglishDescription" id="EnglishDescription" class="form-control" rows="4" placeholder="Enter English description"></textarea>
                                        <small class="form-text text-muted">If left empty, Arabic description will be used</small>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="ContactEmail" class="control-label"></label>
                                        <input asp-for="ContactEmail" class="form-control" />
                                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Publisher Logo -->
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Publisher Logo</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <div class="text-center mb-3">
                                            <img id="logoPreview"
                                                 src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "/images/default-user.png" : Model.LogoUrl)"
                                                 class="img-circle"
                                                 style="width: 150px; height: 150px; object-fit: cover;" />
                                        </div>

                                        <input type="hidden" name="OldLogoUrl" value="@Model.LogoUrl" />

                                        <div class="custom-file">
                                            <input type="file" name="LogoUrl" class="custom-file-input" id="imageInput" accept="image/*" />
                                            <label class="custom-file-label" for="imageInput">Choose logo...</label>
                                        </div>
                                        <small class="form-text text-muted">Supported formats: JPG, PNG. Max size: 2MB</small>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-4 text-right">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            // Image preview
            $(document).on("change", "#imageInput", function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $("#logoPreview").attr("src", e.target.result);
                    }
                    reader.readAsDataURL(file);

                    const fileName = $(this).val().split("\\").pop();
                    $(this).next(".custom-file-label").text(fileName);
                } else {
                    const oldImageUrl = '@Model.LogoUrl';
                    $("#logoPreview").attr("src", oldImageUrl || "/images/default-user.png");
                    $(this).next(".custom-file-label").text("Choose logo...");
                }
            });
        });
    </script>
}
