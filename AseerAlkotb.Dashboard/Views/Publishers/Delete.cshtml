@model AseerAlkotb.Application.Features.Publishers.Response.GetPublisherByIdResponse

@{
    ViewData["Title"] = "Delete Publisher";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Publisher</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Publishers</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-danger">
                    <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                    Are you sure you want to delete this publisher? This action cannot be undone.
                </div>

                <div class="row">
                    <div class="col-md-3 text-center">
                        <img src="@Model.LogoUrl" alt="@Model.Name Logo" class="img-fluid rounded" style="max-height: 250px;" />
                    </div>
                    <div class="col-md-9">
                        <h3>@Model.Name</h3>
                        <dl class="row mt-3">
                            <dt class="col-sm-3">Contact Email</dt>
                            <dd class="col-sm-9">@Model.ContactEmail</dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        </dl>

                        <form asp-action="DeleteConfirmed" class="mt-4">
                            <input type="hidden" asp-for="Id" />
                            <div class="text-right">
                                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this publisher?')">
                                    <i class="fas fa-trash mr-1"></i> Delete
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>