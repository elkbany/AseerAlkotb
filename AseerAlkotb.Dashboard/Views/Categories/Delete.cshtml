@model AseerAlkotb.Application.Features.Categories.Responses.GetCategoryByIdResponse

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title text-danger">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Category Deletion
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-exclamation-triangle"></i> Warning!</h5>
                        <p>Are you sure you want to delete this category? This action cannot be undone.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">Category Name:</dt>
                                <dd class="col-sm-8">@Model.Name</dd>

                                <dt class="col-sm-4">Description:</dt>
                                <dd class="col-sm-8">
                                    @if (string.IsNullOrEmpty(Model.Description))
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                    else
                                    {
                                        @Model.Description
                                    }
                                </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Created At:</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0"><i class="fas fa-info-circle"></i> Important Information</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled mb-0">
                                        <li><i class="fas fa-check text-success"></i> The category will be permanently deleted</li>
                                        <li><i class="fas fa-check text-success"></i> Linked books will not be affected</li>
                                        <li><i class="fas fa-exclamation-triangle text-warning"></i> This action cannot be undone</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash"></i> Confirm Deletion
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirm deletion with custom message
        $(document).ready(function() {
            $('form').on('submit', function(e) {
                if (!confirm('Are you sure you want to delete the category "@Model.Name"?\n\nThis action cannot be undone!')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
} 