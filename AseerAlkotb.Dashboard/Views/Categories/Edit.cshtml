@model AseerAlkotb.Application.Features.Categories.Requests.UpdateCategoryRequest

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Edit Category</h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editCategoryForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible">
                                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                                <h5><i class="icon fas fa-ban"></i> Error!</h5>
                                @TempData["Error"]
                            </div>
                        }
                        
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible">
                                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                                <h5><i class="icon fas fa-check"></i> Success!</h5>
                                @TempData["Success"]
                            </div>
                        }
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label">Category Name (Arabic) *</label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="EnglishName" class="form-label">Category Name (English)</label>
                                    <input name="EnglishName" id="EnglishName" class="form-control" placeholder="Enter English category name" />
                                    <small class="form-text text-muted">If left empty, Arabic name will be used</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="IsActive" class="form-label">Status</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" asp-for="IsActive">
                                            Activate Category
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Description (Arabic)</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter category description (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="EnglishDescription" class="form-label">Description (English)</label>
                            <textarea name="EnglishDescription" id="EnglishDescription" class="form-control" rows="4" placeholder="Enter English category description"></textarea>
                            <small class="form-text text-muted">If left empty, Arabic description will be used</small>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Category Validation Functions
            function validateId(id) {
                var errors = [];
                if (!id || id <= 0) {
                    errors.push('Category ID must be greater than 0.');
                }
                return errors;
            }

            function validateName(name) {
                var errors = [];
                
                if (!name || name.trim() === '') {
                    errors.push('Category name is required.');
                } else {
                    if (name.length < 2 || name.length > 100) {
                        errors.push('Category name must be between 2 and 100 characters.');
                    }
                    
                    var namePattern = /^[a-zA-Z\u0600-\u06FF\s]+$/;
                    if (!namePattern.test(name)) {
                        errors.push('Category name must contain only letters and spaces.');
                    }
                }
                
                return errors;
            }

            function validateDescription(description) {
                var errors = [];
                
                if (description && description.length > 1000) {
                    errors.push('Description must not exceed 1000 characters.');
                }
                
                return errors;
            }

            function validateIsActive(isActive) {
                var errors = [];
                
                if (isActive === null || isActive === undefined) {
                    errors.push('Please specify whether the category should be active.');
                }
                
                return errors;
            }

            function showValidationErrors(errors) {
                // Clear previous errors
                $('.validation-error').remove();
                
                if (errors.length > 0) {
                    var errorHtml = '<div class="alert alert-danger validation-error"><h5><i class="icon fas fa-exclamation-triangle"></i> Please check the following:</h5><ul>';
                    errors.forEach(function(error) {
                        errorHtml += '<li>' + error + '</li>';
                    });
                    errorHtml += '</ul></div>';
                    
                    $('.card-body').first().prepend(errorHtml);
                    
                    // Scroll to top to show errors
                    $('html, body').animate({
                        scrollTop: $('.validation-error').offset().top - 100
                    }, 500);
                    
                    return false;
                }
                return true;
            }

            // Form validation on submit
            $('#editCategoryForm').on('submit', function(e) {
                var allErrors = [];
                
                // Validate all fields
                allErrors = allErrors.concat(validateId(parseInt($('#Id').val())));
                allErrors = allErrors.concat(validateName($('#Name').val()));
                allErrors = allErrors.concat(validateDescription($('#Description').val()));
                allErrors = allErrors.concat(validateIsActive($('#IsActive').is(':checked')));
                
                if (!showValidationErrors(allErrors)) {
                    e.preventDefault();
                }
            });

            // Real-time validation feedback
            $('#Name').on('blur', function() {
                var errors = validateName($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });

            $('#Description').on('blur', function() {
                var errors = validateDescription($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });
        });
    </script>
} 