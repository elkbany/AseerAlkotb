@model AseerAlkotb.Application.Features.Categories.Requests.AddSubCategoryRequest

@{
    ViewData["Title"] = "Add New Subcategory";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Add New Subcategory</h3>
                    <div class="card-tools">
                        <a asp-action="SubCategories" asp-route-parentId="@ViewBag.ParentCategory.Id" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Subcategories
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Parent Category Info -->
                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle"></i> Parent Category Info:</h6>
                        <p class="mb-0">
                            <strong>Category Name:</strong> @ViewBag.ParentCategory.Name
                            @if (!string.IsNullOrEmpty(ViewBag.ParentCategory.Description))
                            {
                                <br><strong>Description:</strong> @ViewBag.ParentCategory.Description
                            }
                        </p>
                    </div>

                    <form asp-action="CreateSubCategory" method="post">
                        <input type="hidden" name="parentId" value="@ViewBag.ParentCategory.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label">Subcategory Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter subcategory name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="IsActive" class="form-label">Status</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" asp-for="IsActive">
                                            Activate Subcategory
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter subcategory description (optional)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Save Subcategory
                            </button>
                            <a asp-action="SubCategories" asp-route-parentId="@ViewBag.ParentCategory.Id" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Custom validation
        $(document).ready(function() {
            $('form').on('submit', function(e) {
                var name = $('#Name').val().trim();
                if (name.length < 2) {
                    e.preventDefault();
                    alert('Subcategory name must be at least 2 characters');
                    $('#Name').focus();
                    return false;
                }
            });
        });
    </script>
} 