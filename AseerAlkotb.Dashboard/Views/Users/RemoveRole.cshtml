@model AseerAlkotb.Domain.Entites.Models.User

@{
    ViewData["Title"] = "Remove Role";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Remove Role</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">Remove Role</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-times"></i> Remove Role from User
                        </h3>
                        <div class="card-tools">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                            You are about to remove the <strong>@ViewBag.CurrentRole</strong> role from <strong>@Model.FirstName @Model.LastName</strong>.
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="text-center">
                                    <img class="img-fluid rounded" 
                                         src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/images/default-user.png" : Model.ProfilePictureUrl)" 
                                         alt="@Model.FirstName" style="max-width: 150px;">
                                </div>
                                <h4 class="text-center mt-2">@Model.FirstName @Model.LastName</h4>
                                <p class="text-muted text-center">@Model.UserName</p>
                            </div>
                            <div class="col-md-8">
                                <h5>Current Role</h5>
                                @if (ViewBag.CurrentRole != null)
                                {
                                    <p>
                                        <span class="badge badge-@(ViewBag.CurrentRole == "Admin" ? "success" : "warning") badge-lg">
                                            @ViewBag.CurrentRole
                                        </span>
                                    </p>
                                    
                                    <div class="alert alert-info">
                                        <h6><i class="icon fas fa-info"></i> What this role provides:</h6>
                                        @if (ViewBag.CurrentRole == "Admin")
                                        {
                                            <ul class="mb-0">
                                                <li>Full access to all system features</li>
                                                <li>User management capabilities</li>
                                                <li>System configuration access</li>
                                                <li>Content moderation tools</li>
                                                <li>Analytics and reporting access</li>
                                            </ul>
                                        }
                                        else if (ViewBag.CurrentRole == "Client")
                                        {
                                            <ul class="mb-0">
                                                <li>Browse and view content</li>
                                                <li>Personal profile management</li>
                                                <li>Basic user interactions</li>
                                                <li>Limited system access</li>
                                            </ul>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p><span class="badge badge-secondary badge-lg">No Role Assigned</span></p>
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle"></i> This user currently has no role assigned.
                                    </div>
                                }

                                <h5 class="mt-4">Impact of Removing Role</h5>
                                <div class="alert alert-danger">
                                    <h6><i class="icon fas fa-exclamation-triangle"></i> Removing the @ViewBag.CurrentRole role will:</h6>
                                    <ul class="mb-0">
                                        <li>Revoke all associated permissions</li>
                                        <li>Limit user access to basic features only</li>
                                        <li>Remove administrative capabilities (if Admin role)</li>
                                        <li>Require manual role reassignment for access restoration</li>
                                    </ul>
                                </div>

                                <h5 class="mt-4">Alternative Actions</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card card-outline card-warning">
                                            <div class="card-header">
                                                <h6 class="card-title">
                                                    <i class="fas fa-exchange-alt"></i> Change Role Instead
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">
                                                    Instead of removing the role, you can assign a different role to maintain user access.
                                                </p>
                                                <a asp-action="AssignRole" asp-route-id="@Model.Id" class="btn btn-warning btn-block">
                                                    <i class="fas fa-exchange-alt"></i> Change Role
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card card-outline card-info">
                                            <div class="card-header">
                                                <h6 class="card-title">
                                                    <i class="fas fa-edit"></i> Edit User
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">
                                                    Modify user information or settings instead of removing their role.
                                                </p>
                                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info btn-block">
                                                    <i class="fas fa-edit"></i> Edit User
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        @if (ViewBag.CurrentRole != null)
                        {
                            <form asp-action="RemoveRole" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="role" value="@ViewBag.CurrentRole" />
                                <div class="row">
                                    <div class="col-md-6">
                                        <button type="submit" class="btn btn-danger btn-block" 
                                                onclick="return confirm('Are you absolutely sure you want to remove the @ViewBag.CurrentRole role from @Model.FirstName? This will revoke all associated permissions.')">
                                            <i class="fas fa-user-times"></i> Remove @ViewBag.CurrentRole Role
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <a asp-action="Index" class="btn btn-secondary btn-block">
                                            <i class="fas fa-times"></i> Cancel
                                        </a>
                                    </div>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <!-- User Information Sidebar -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">User Information</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8">@Model.Email</dd>
                            
                            <dt class="col-sm-4">Gender:</dt>
                            <dd class="col-sm-8">@Model.Gender</dd>
                            
                            <dt class="col-sm-4">Phone:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                            </dd>
                            
                            <dt class="col-sm-4">Nationality:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.Nationality) ? "Not specified" : Model.Nationality)
                            </dd>
                            
                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8">
                                <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </dd>
                            
                            <dt class="col-sm-4">Member Since:</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM yyyy")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group-vertical w-100">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm mb-2">
                                <i class="fas fa-edit"></i> Edit User
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-sm mb-2">
                                <i class="fas fa-info-circle"></i> View Details
                            </a>
                            <a asp-action="AssignRole" asp-route-id="@Model.Id" class="btn btn-warning btn-sm mb-2">
                                <i class="fas fa-user-tag"></i> Manage Roles
                            </a>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Enable tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}



