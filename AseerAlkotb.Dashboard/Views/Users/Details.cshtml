@using AseerAlkotb.Application.Features.Roles.Responses
@model GetAllAdminResponse

@{
    ViewData["Title"] = "User Details";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">User Details</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <!-- Profile Card -->
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <div class="text-center">
                            <img class="profile-user-img img-fluid img-circle" 
                                 src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/images/default-user.png" : Model.ProfilePictureUrl)" 
                                 alt="@Model.FirstName">
                        </div>
                        <h3 class="profile-username text-center">@Model.FirstName @Model.LastName</h3>
                        <p class="text-muted text-center">@Model.UserName</p>
                        
                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>Role</b> <a class="float-right">
                                    @if (ViewBag.CurrentRole != null)
                                    {
                                        <span class="badge badge-@(ViewBag.CurrentRole == "Admin" ? "success" : "warning")">
                                            @ViewBag.CurrentRole
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No Role</span>
                                    }
                                </a>
                            </li>
                            <li class="list-group-item">
                                <b>Status</b> <a class="float-right">
                                    <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                                        @(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                </a>
                            </li>
                            
                        </ul>
                        
                        <div class="text-center">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="fas fa-edit"></i> Edit User
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-8">
                <!-- User Information -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">User Information</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">First Name:</dt>
                                    <dd class="col-sm-8">@Model.FirstName</dd>
                                    
                                    <dt class="col-sm-4">Last Name:</dt>
                                    <dd class="col-sm-8">@Model.LastName</dd>
                                    
                                    <dt class="col-sm-4">Username:</dt>
                                    <dd class="col-sm-8">@Model.UserName</dd>
                                    
                                    <dt class="col-sm-4">Email:</dt>
                                    <dd class="col-sm-8">
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Gender:</dt>
                                    <dd class="col-sm-8">@Model.Gender</dd>
                                    
                                    <dt class="col-sm-4">Phone Number:</dt>
                                    <dd class="col-sm-8">
                                        @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                                    </dd>
                                    
                                    <dt class="col-sm-4">Nationality:</dt>
                                    <dd class="col-sm-8">
                                        @(string.IsNullOrEmpty(Model.Nationality) ? "Not specified" : Model.Nationality)
                                    </dd>
                                    
                                    <dt class="col-sm-4">Account Created:</dt>
                                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                                    
                                    <dt class="col-sm-4">Last Updated:</dt>
                                    <dd class="col-sm-8">@Model.UpdatedAt.ToString("dd/MM/yyyy")</dd>
                                </dl>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
                <!-- Role Management -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Role Management</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Current Role</h5>
                                @if (ViewBag.CurrentRole != null)
                                {
                                    <p>
                                        <span class="badge badge-@(ViewBag.CurrentRole == "Admin" ? "success" : "warning") badge-lg">
                                            @ViewBag.CurrentRole
                                        </span>
                                    </p>
                                }
                                else
                                {
                                    <p><span class="badge badge-secondary badge-lg">No Role Assigned</span></p>
                                }
                            </div>
                            <div class="col-md-6">
                                <h5>Actions</h5>
                                <div class="btn-group-vertical w-100">
                                    @if (ViewBag.CurrentRole != "Admin")
                                    {
                                        <form asp-action="AssignRole" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="role" value="Admin" />
                                            <button type="submit" class="btn btn-success btn-sm mb-2 w-100" 
                                                    onclick="return confirm('Are you sure you want to assign Admin role to this user?')">
                                                <i class="fas fa-user-shield"></i> Assign Admin Role
                                            </button>
                                        </form>
                                    }
                                    @if (ViewBag.CurrentRole != "Client")
                                    {
                                        <form asp-action="AssignRole" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="role" value="Client" />
                                            <button type="submit" class="btn btn-warning btn-sm mb-2 w-100"
                                                    onclick="return confirm('Are you sure you want to assign Client role to this user?')">
                                                <i class="fas fa-user"></i> Assign Client Role
                                            </button>
                                        </form>
                                    }
                                    @if (ViewBag.CurrentRole != null)
                                    {
                                        <form asp-action="RemoveRole" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="role" value="@ViewBag.CurrentRole" />
                                            <button type="submit" class="btn btn-danger btn-sm w-100"
                                                    onclick="return confirm('Are you sure you want to remove the @ViewBag.CurrentRole role from this user?')">
                                                <i class="fas fa-user-times"></i> Remove @ViewBag.CurrentRole Role
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Orders Section -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Purchase History</h3>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Orders != null && ((List<AseerAlkotb.Application.Features.Roles.Responses.OrderDetailsResponse>)ViewBag.Orders).Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Order #</th>
                                            <th>Date</th>
                                            <th>Items</th>
                                            <th>Total Amount</th>
                                            <th>Status</th>
                                            <th>Payment Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in ViewBag.Orders)
                                        {
                                            <tr>
                                                <td>#@order.Id</td>
                                                <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                                <td>@order.OrderItems.Count item(s)</td>
                                                <td>@order.FinalAmount.ToString("C")</td>
                                                <td>
                                                    <span class="badge badge-@(order.Status == "Completed" ? "success" : order.Status == "Pending" ? "warning" : "secondary")">
                                                        @order.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-@(order.PaymentStatus == "Paid" ? "success" : "warning")">
                                                        @order.PaymentStatus
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="fas fa-shopping-cart fa-3x mb-3"></i>
                                <p>No orders found for this user.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Reviews</h3>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Reviews != null && ((List<AseerAlkotb.Application.Features.Roles.Responses.ReviewDetailsResponse>)ViewBag.Reviews).Any())
                        {
                            <div class="row">
                                @foreach (var review in ViewBag.Reviews)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <h6 class="card-title">@review.BookTitle</h6>
                                                    <div class="rating">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                        }
                                                    </div>
                                                </div>
                                                <p class="card-text">@review.Comment</p>
                                                <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="fas fa-star fa-3x mb-3"></i>
                                <p>No reviews found for this user.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Wishlist Section -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Wishlist</h3>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Wishlist != null && ((List<AseerAlkotb.Application.Features.Roles.Responses.WishlistItemDetailsResponse>)ViewBag.Wishlist).Any())
                        {
                            <div class="row">
                                @foreach (var item in ViewBag.Wishlist)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card">
                                            <img src="@item.BookCoverImageUrl" class="card-img-top" alt="@item.BookTitle" style="height: 200px; object-fit: cover;">
                                            <div class="card-body">
                                                <h6 class="card-title">@item.BookTitle</h6>
                                                <p class="card-text">by @item.AuthorName</p>
                                                <p class="card-text"><strong>@item.Price.ToString("C")</strong></p>
                                                <small class="text-muted">Added: @item.AddedAt.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="fas fa-heart fa-3x mb-3"></i>
                                <p>No items in wishlist.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Account Actions -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Account Actions</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-block mb-2">
                                    <i class="fas fa-edit"></i> Edit User
                                </a>
                                <a asp-action="Index" class="btn btn-secondary btn-block">
                                    <i class="fas fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-block"
                                   onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                    <i class="fas fa-trash"></i> Delete User
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Enable tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}

