@model AseerAlkotb.Domain.Entites.Models.User

@{
    ViewData["Title"] = "Assign Role";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Assign Role</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">Assign Role</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Assign Role to User</h3>
                        <div class="card-tools">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="text-center">
                                    <img class="img-fluid rounded" 
                                         src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/images/default-user.png" : Model.ProfilePictureUrl)" 
                                         alt="@Model.FirstName" style="max-width: 150px;">
                                </div>
                                <h4 class="text-center mt-2">@Model.FirstName @Model.LastName</h4>
                                <p class="text-muted text-center">@Model.UserName</p>
                            </div>
                            <div class="col-md-8">
                                <h5>Current Role</h5>
                                @if (ViewBag.CurrentRole != null)
                                {
                                    <p>
                                        <span class="badge badge-@(ViewBag.CurrentRole == "Admin" ? "success" : "warning") badge-lg">
                                            @ViewBag.CurrentRole
                                        </span>
                                    </p>
                                }
                                else
                                {
                                    <p><span class="badge badge-secondary badge-lg">No Role Assigned</span></p>
                                }

                                <h5 class="mt-4">Available Roles</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card card-outline card-success">
                                            <div class="card-header">
                                                <h6 class="card-title">
                                                    <i class="fas fa-user-shield"></i> Administrator
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">
                                                    Full access to all system features and user management capabilities.
                                                </p>
                                                <ul class="list-unstyled">
                                                    <li><i class="fas fa-check text-success"></i> User management</li>
                                                    <li><i class="fas fa-check text-success"></i> System configuration</li>
                                                    <li><i class="fas fa-check text-success"></i> Content moderation</li>
                                                    <li><i class="fas fa-check text-success"></i> Analytics access</li>
                                                </ul>
                                                @if (ViewBag.CurrentRole != "Admin")
                                                {
                                                    <form asp-action="AssignRole" method="post" class="mt-3">
                                                        <input type="hidden" name="id" value="@Model.Id" />
                                                        <input type="hidden" name="role" value="Admin" />
                                                        <button type="submit" class="btn btn-success btn-block"
                                                                onclick="return confirm('Are you sure you want to assign Administrator role to @Model.FirstName? This will give them full system access.')">
                                                            <i class="fas fa-user-shield"></i> Assign Admin Role
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info mt-3">
                                                        <i class="fas fa-info-circle"></i> User already has this role
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card card-outline card-warning">
                                            <div class="card-header">
                                                <h6 class="card-title">
                                                    <i class="fas fa-user"></i> Client
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">
                                                    Standard user access with limited system features.
                                                </p>
                                                <ul class="list-unstyled">
                                                    <li><i class="fas fa-check text-success"></i> Browse content</li>
                                                    <li><i class="fas fa-check text-success"></i> Personal profile</li>
                                                    <li><i class="fas fa-check text-success"></i> Basic interactions</li>
                                                    <li><i class="fas fa-times text-muted"></i> No admin access</li>
                                                </ul>
                                                @if (ViewBag.CurrentRole != "Client")
                                                {
                                                    <form asp-action="AssignRole" method="post" class="mt-3">
                                                        <input type="hidden" name="id" value="@Model.Id" />
                                                        <input type="hidden" name="role" value="Client" />
                                                        <button type="submit" class="btn btn-warning btn-block"
                                                                onclick="return confirm('Are you sure you want to assign Client role to @Model.FirstName? This will limit their system access.')">
                                                            <i class="fas fa-user"></i> Assign Client Role
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info mt-3">
                                                        <i class="fas fa-info-circle"></i> User already has this role
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <!-- User Information Sidebar -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">User Information</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Email:</dt>
                            <dd class="col-sm-8">@Model.Email</dd>
                            
                            <dt class="col-sm-4">Gender:</dt>
                            <dd class="col-sm-8">@Model.Gender</dd>
                            
                            <dt class="col-sm-4">Phone:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                            </dd>
                            
                            <dt class="col-sm-4">Nationality:</dt>
                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.Nationality) ? "Not specified" : Model.Nationality)
                            </dd>
                            
                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8">
                                <span class="badge badge-@(Model.IsActive ? "success" : "secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </dd>
                            
                            <dt class="col-sm-4">Member Since:</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM yyyy")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group-vertical w-100">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm mb-2">
                                <i class="fas fa-edit"></i> Edit User
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-sm mb-2">
                                <i class="fas fa-info-circle"></i> View Details
                            </a>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Enable tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}




















