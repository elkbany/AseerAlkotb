@model AseerAlkotb.Application.Features.Roles.Responses.GetAllAdminResponse

@{
    ViewData["Title"] = "Delete User";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete User</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-exclamation-triangle"></i> Confirm User Deletion
                        </h3>
                        <div class="card-tools">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                            You are about to delete the user <strong>@Model.FirstName @Model.LastName</strong>. 
                            This action cannot be undone and will permanently remove all associated data.
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="text-center">
                                    <img class="img-fluid rounded" 
                                         src="/images/default-user.png" 
                                         alt="@Model.FirstName" style="max-width: 200px;">
                                </div>
                            </div>
                            <div class="col-md-8">
                                <h4>User Information</h4>
                                <dl class="row">
                                    <dt class="col-sm-4">Full Name:</dt>
                                    <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>
                                    
                                    <dt class="col-sm-4">Username:</dt>
                                    <dd class="col-sm-8">@Model.UserName</dd>
                                    
                                    <dt class="col-sm-4">Email:</dt>
                                    <dd class="col-sm-8">@Model.Email</dd>
                                    
                                    
                                    
                                    <dt class="col-sm-4">Phone Number:</dt>
                                    <dd class="col-sm-8">
                                        @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                                    </dd>
                                    
                                    <dt class="col-sm-4">Nationality:</dt>
                                    <dd class="col-sm-8">
                                        @(string.IsNullOrEmpty(Model.Nationality) ? "Not specified" : Model.Nationality)
                                    </dd>
                                    
                                    <dt class="col-sm-4">Current Role:</dt>
                                    <dd class="col-sm-8">
                                        @if (ViewBag.CurrentRole != null)
                                        {
                                            <span class="badge badge-@(ViewBag.CurrentRole == "Admin" ? "success" : "warning")">
                                                @ViewBag.CurrentRole
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">No Role</span>
                                        }
                                    </dd>
                                    
                                    
                                    
                                    
                                </dl>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <h6><i class="icon fas fa-info"></i> What will be deleted:</h6>
                            <ul class="mb-0">
                                <li>User account and profile information</li>
                                <li>All associated roles and permissions</li>
                                <li>Profile picture (if exists)</li>
                                <li>User preferences and settings</li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="row">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-danger btn-block" 
                                            onclick="return confirm('Are you absolutely sure you want to delete this user? This action cannot be undone.')">
                                        <i class="fas fa-trash"></i> Delete User Permanently
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-action="Index" class="btn btn-secondary btn-block">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Enable tooltips
            $('[data-toggle="tooltip"]').tooltip();
            
            // Additional confirmation for delete button
            $('form').submit(function(e) {
                var confirmed = confirm('Are you absolutely sure you want to delete this user? This action cannot be undone.');
                if (!confirmed) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

