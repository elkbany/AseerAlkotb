@model EmbeddingsIndexVM
@{
    ViewData["Title"] = "Smart Search (AI) – Indexing";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Smart Search (AI) – Indexing</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Smart Search</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- Status / Alerts -->
        <div id="bg-status" class="mb-3"></div>

        @if (TempData["ok"] != null)
        {
            <div class="alert alert-success">@TempData["ok"]</div>
        }
        @if (TempData["err"] != null)
        {
            <div class="alert alert-danger">@TempData["err"]</div>
        }

        <!-- Statistics Cards (مثل books) -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.Total</h3>
                        <p>Total Indexed Books</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-brain"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Card -->
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Indexed Books</h3>

                    <form asp-action="RebuildAll" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-warning"
                                type="submit"
                                onclick="return confirm('Rebuild indexes for all books?');">
                            <i class="fas fa-rotate"></i> Rebuild All Indexes
                        </button>
                    </form>
                </div>
            </div>

            <div class="card-body">
                <!-- Search -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <form method="get" class="form-inline">
                            <div class="input-group w-100">
                                <input name="q"
                                       class="form-control"
                                       value="@Model.Query"
                                       placeholder="Search by title" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Table (نفس ستايل Books) -->
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Categories</th>
                                <th>Index Updated (UTC)</th>
                                <th style="width:300px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td>@r.Title</td>
                                    <td>@r.Author</td>
                                    <td>@r.Categories</td>
                                    <td>@(r.LastUpdated?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                    <td>
                                        <div class="btn-group">
                                            <form asp-action="RebuildOne" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.BookId" />
                                                <button class="btn btn-sm btn-outline-primary" type="submit" title="Rebuild this book index">
                                                    <i class="fas fa-rotate"></i>
                                                </button>
                                            </form>
                                            <form asp-action="DeleteOne" method="post" class="d-inline ms-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.BookId" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                                        onclick="return confirm('Delete index for this book?');"
                                                        title="Delete index">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                            <a class="btn btn-sm btn-outline-secondary ms-1"
                                               asp-action="ViewEmbeddings"
                                               asp-route-id="@r.BookId"
                                               title="View indexed chunks">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination (مطابق لصفحة الكتب) -->
                @if (Model.Total > Model.PageSize)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @{
                                var pages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
                                var current = Model.Page;
                            }

                            @if (current > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-page="@(current - 1)" asp-route-q="@Model.Query">Previous</a>
                                </li>
                            }

                            @for (int i = 1; i <= Math.Ceiling((double)Model.Total / Model.PageSize); i++)
                            {
                                <li class="page-item @(i == current ? "active" : "")">
                                    <a class="page-link" asp-route-page="@i" asp-route-q="@Model.Query">@i</a>
                                </li>
                            }

                            @if (current < Math.Ceiling((double)Model.Total / Model.PageSize))
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-page="@(current + 1)" asp-route-q="@Model.Query">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (async function pollStatus(){
            try{
                const r = await fetch('/EmbeddingsAdmin/Status', { cache: 'no-store' });
                const text = await r.text();
                const el = document.getElementById('bg-status');

                if (text && text.trim().startsWith('{')) {
                    const s = JSON.parse(text);
                    const running = s.isRunning ? '🟢 Running' : '⚪ Idle';
                    const phase = s.currentPhase || 'idle';
                    const pct = (s.total > 0) ? Math.floor((s.processed / s.total) * 100) : 0;

                    el.innerHTML = `
                        <div class="alert ${s.isRunning ? 'alert-info' : 'alert-secondary'} d-flex align-items-center justify-content-between">
                            <div>
                                <strong>Status:</strong> ${running}
                                &nbsp; | &nbsp; <strong>Phase:</strong> ${phase}
                                &nbsp; | &nbsp; <strong>Progress:</strong> ${s.processed}/${s.total} (${pct}%)
                                ${s.lastError ? `&nbsp; | &nbsp; <strong class="text-danger">Last error:</strong> ${s.lastError}` : ''}
                            </div>
                            <button class="btn btn-sm btn-outline-dark" onclick="location.reload()">Refresh</button>
                        </div>`;
                } else {
                    el.innerHTML = `<div class="alert alert-danger">Background job service is not available.</div>`;
                }
            } catch {
                document.getElementById('bg-status').innerHTML =
                    `<div class="alert alert-danger">Background job service is not available.</div>`;
            }
        })();
    </script>
}
