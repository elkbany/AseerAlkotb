@model AseerAlkotb.Application.Features.Books.Responses.GetBookByIdResponse
@using System.Globalization

@{
    ViewData["Title"] = "Book Details";
    var egp = CultureInfo.GetCultureInfo("en-EG");

    var inv = CultureInfo.InvariantCulture;

    // Get all reviews for this book to calculate rating distribution
    var reviews = ViewBag.Reviews as List<AseerAlkotb.Application.Features.Reviews.Responses.GetAllReviewsPaginatedResponse> ?? new List<AseerAlkotb.Application.Features.Reviews.Responses.GetAllReviewsPaginatedResponse>();

    // Calculate rating statistics
    var totalReviews = reviews.Count;
    var averageRating = totalReviews > 0 ? reviews.Average(r => r.Rating) : 0;

    // Calculate distribution for each star rating
    var starDistribution = new Dictionary<int, int>();
    for (int i = 1; i <= 5; i++)
    {
        starDistribution[i] = reviews.Count(r => r.Rating == i);
    }

    // Calculate percentages
    var starPercentages = new Dictionary<int, decimal>();
    for (int i = 1; i <= 5; i++)
    {
        starPercentages[i] = totalReviews > 0 ? (decimal)starDistribution[i] / totalReviews * 100 : 0;
    }
}
@functions {
    string ResolveImg(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return Url.Content("~/images/default-book.png");

        // already absolute (http/https)
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return url;

        // normalize relative to app
        if (url.StartsWith("~/"))
            return Url.Content(url);

        if (url.StartsWith("/"))
            return Url.Content("~" + url);

        // fallback
        return Url.Content("~/" + url);
    }
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@Model.Title</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/"><i class="fas fa-home"></i></a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="card card-outline card-primary">
                    <div class="card-body box-profile">
                        <div class="text-center position-relative mb-3 cover-wrap">
                            <img src="@ResolveImg(Model.CoverImageUrl)"
                                 alt="@Model.Title"
                                 class="cover-img"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-book.png")';" />

                            @if (Model.DiscountPercentage > 0)
                            {
                                <div class="badge badge-danger cover-badge">
                                    -@(Model.DiscountPercentage)%
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary") p-2">
                                <i class="fas @(Model.IsActive ? "fa-check-circle" : "fa-times-circle") mr-1"></i>
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="badge @(Model.StockQuantity > 0 ? "badge-info" : "badge-danger") p-2">
                                <i class="fas @(Model.StockQuantity > 0 ? "fa-box" : "fa-box-open") mr-1"></i>
                                @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                            </span>
                        </div>

                        <div class="text-center">
                            <h3 class="profile-username">@((Model.Price - (Model.Price * Model.DiscountPercentage / 100m)).ToString("C", egp))</h3>
                            @if (Model.DiscountPercentage > 0)
                            {
                                <p class="text-muted text-sm">
                                    Original Price: <strike>@(Model.Price.ToString("C", egp))</strike>
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Quick Actions</h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="btn-group-vertical w-100 btn-stack">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-action">
                                <i class="fas fa-edit"></i> Edit Book
                            </a>

                            <a asp-action="Index" class="btn btn-secondary btn-action">
                                <i class="fas fa-list"></i> Back to List
                            </a>

                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-action">
                                <i class="fas fa-trash"></i> Delete Book
                            </a>
                        </div>

                    </div>
                </div>

            </div>

            <div class="col-md-9">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Book Information</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-barcode"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">ISBN</span>
                                        <span class="info-box-number">@Model.ISBN</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-user"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Author</span>
                                        <span class="info-box-number">@ViewBag.Author?.Name</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-building"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Publisher</span>
                                        <span class="info-box-number">@ViewBag.Publisher?.Name</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-language"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Language</span>
                                        <span class="info-box-number">@Model.Language</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-tags"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Categories</span>
                                        <div class="info-box-number">
                                            @{
                                                var categories = ViewBag.Categories as List<string>;
                                            }
                                            @if (categories != null && categories.Any())
                                            {
                                                foreach (var category in categories)
                                                {
                                                    <span class="badge badge-primary mr-1">@category</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No categories assigned</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card card-outline card-info mb-0">
                                    <div class="card-header">
                                        <h3 class="card-title">Description</h3>
                                    </div>
                                    <div class="card-body">
                                        @Html.Raw(Model.Description)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-outline card-warning">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-star text-warning mr-2"></i>
                            Rating and Reviews
                        </h3>
                    </div>

                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center">
                                <h1 class="display-4 text-warning mb-0">@averageRating.ToString("0.0")</h1>
                                <div class="rating-stars">
                                    @{
                                        int fullStars = (int)Math.Floor((decimal)averageRating);
                                        bool hasHalfStar = (averageRating - fullStars) >= 0.5;
                                        int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                                    }

                                    @* Display full stars *@
                                    @for (int i = 1; i <= fullStars; i++)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }

                                    @* Display half star if needed *@
                                    @if (hasHalfStar)
                                    {
                                        <i class="fas fa-star-half-alt text-warning"></i>
                                    }

                                    @* Display empty stars *@
                                    @for (int i = 1; i <= emptyStars; i++)
                                    {
                                        <i class="far fa-star text-muted"></i>
                                    }
                                </div>
                                <p class="text-muted mt-2">
                                    Based on @totalReviews customer review@(totalReviews != 1 ? "s" : "")
                                </p>
                            </div>
                            <div class="col-md-8">
                                @if (totalReviews > 0)
                                {
                                    @for (int starLevel = 5; starLevel >= 1; starLevel--)
                                    {
                                        <div class="progress-group mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="progress-text">
                                                    <i class="fas fa-star text-warning me-1"></i>
                                                    @starLevel star@(starLevel > 1 ? "s" : "")
                                                </span>
                                                <span class="text-muted small">
                                                    @starDistribution[starLevel] (@starPercentages[starLevel].ToString("0")%)
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar bg-warning"
                                                     data-target-width="@starPercentages[starLevel].ToString("0.0", inv)"
                                                     style="width:0%"
                                                     role="progressbar"
                                                     aria-valuenow="@starPercentages[starLevel].ToString("0.0", inv)"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center text-muted py-4">
                                        <i class="fas fa-star-o fa-2x mb-2"></i>
                                        <p>No reviews yet.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (totalReviews > 0)
                        {
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0">Customer Reviews (@totalReviews)</h5>
                                    </div>

                                    @* Display recent reviews *@
                                    @foreach (var review in reviews.Take(3))
                                    {
                                        <div class="card border-left-warning mb-3">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div class="rating-stars">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                        }
                                                    </div>
                                                    <small class="text-muted">User @review.UserId</small>
                                                </div>
                                                <p class="mb-0">@review.Comment</p>
                                            </div>
                                        </div>
                                    }

                                    @if (totalReviews > 3)
                                    {
                                        <div class="text-center">
                                            <a href="#" class="btn btn-outline-primary btn-sm">
                                                View All @totalReviews Reviews
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Styles {

    <style>
        .progress-bar {
            transition: width 0.9s ease-in-out;
        }

        .rating-stars {
            font-size: 1.5rem;
        }

        .progress {
            height: 1rem;
        }

        .progress-group {
            margin-bottom: 1rem;
        }

        .info-box-number .badge {
            font-size: 0.9rem;
        }

        .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__choice {
            background-color: #007bff;
            border: none;
            color: #fff;
            padding: 0.2rem 0.6rem;
        }

        .select2-container--disabled .select2-selection--multiple {
            background-color: #e9ecef !important;
            cursor: not-allowed;
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
        if ($.fn.select2) {
          $('.select2').select2({
            theme: 'bootstrap4',
            width: '100%',
            placeholder: 'Categories',
            allowClear: true
          });
        }

             const bars = document.querySelectorAll('.progress-bar[data-target-width]');
        if (!('IntersectionObserver' in window)) {
            // fallback: لو المتصفح قديم، حرّكها فورًا
            bars.forEach(bar => {
                const target = bar.getAttribute('data-target-width');
                bar.style.width = target + '%';
                bar.setAttribute('aria-valuenow', target);
            });
            return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const bar = entry.target;
                    const target = bar.getAttribute('data-target-width') || '0';
                    // حرّك العرض للنسبة المطلوبة
                    requestAnimationFrame(() => {
                        bar.style.width = target + '%';
                        bar.setAttribute('aria-valuenow', target);
                    });
                    obs.unobserve(bar); // نفّذ مرة واحدة لكل شريط
                }
            });
        }, { threshold: 0.35 }); // يبدأ لما 35% من العنصر تبقى ظاهرة

        bars.forEach(bar => observer.observe(bar));
        });
    </script>
}