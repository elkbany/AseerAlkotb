@model AseerAlkotb.Application.Features.Books.Responses.GetBookByIdResponse

@{
    ViewData["Title"] = "Book Details";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@Model.Title</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/"><i class="fas fa-home"></i></a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="card card-outline card-primary">
                    <div class="card-body box-profile">
                        <div class="text-center position-relative mb-3">
                            <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-book.png" : Model.CoverImageUrl)"
                                 alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                            @if (Model.DiscountPercentage > 0)
                            {
                                <div class="position-absolute badge badge-danger" style="top: 10px; right: 10px; font-size: 1rem;">
                                    -@(Model.DiscountPercentage)%
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary") p-2">
                                <i class="fas @(Model.IsActive ? "fa-check-circle" : "fa-times-circle") mr-1"></i>
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="badge @(Model.StockQuantity > 0 ? "badge-info" : "badge-danger") p-2">
                                <i class="fas @(Model.StockQuantity > 0 ? "fa-box" : "fa-box-open") mr-1"></i>
                                @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                            </span>
                        </div>

                        <div class="text-center">
                            <h3 class="profile-username">@Model.Price.ToString("C")</h3>
                            @if (Model.DiscountPercentage > 0)
                            {
                                <p class="text-muted text-sm">
                                    Original Price: <strike>@((Model.Price / (1 - Model.DiscountPercentage / 100m)).ToString("C"))</strike>
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Quick Actions</h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="btn-group-vertical w-100">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary text-left">
                                <i class="fas fa-edit mr-2"></i> Edit Book
                            </a>
                            <a asp-action="Index" class="btn btn-secondary text-left">
                                <i class="fas fa-list mr-2"></i> Back to List
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger text-left">
                                <i class="fas fa-trash mr-2"></i> Delete Book
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Book Information</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-barcode"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">ISBN</span>
                                        <span class="info-box-number">@Model.ISBN</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-user"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Author</span>
                                        <span class="info-box-number">@ViewBag.Author?.Name</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-building"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Publisher</span>
                                        <span class="info-box-number">@ViewBag.Publisher?.Name</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-language"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Language</span>
                                        <span class="info-box-number">@Model.Language</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon"><i class="fas fa-tags"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Categories</span>
                                        <div class="info-box-number">
                                            @{
                                                var categories = ViewBag.Categories as List<string>;
                                            }
                                            @if (categories != null && categories.Any())
                                            {
                                                foreach (var category in categories)
                                                {
                                                    <span class="badge badge-primary mr-1">@category</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No categories assigned</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card card-outline card-info mb-0">
                                    <div class="card-header">
                                        <h3 class="card-title">Description</h3>
                                    </div>
                                    <div class="card-body">
                                        @Html.Raw(Model.Description)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-outline card-warning">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-star text-warning mr-2"></i>
                            Rating and Reviews
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center">
                                <h1 class="display-4 text-warning mb-0">@Model.Rating.ToString("0.0")</h1>
                                <div class="rating-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= Model.Rating ? "text-warning" : "text-muted")"></i>
                                    }
                                </div>
                                <p class="text-muted mt-2">Based on customer reviews</p>
                            </div>
                            <div class="col-md-8">
                                <div class="progress-group mb-4">
                                    <span class="progress-text">5 stars</span>
                                    <div class="progress">
                                        <div class="progress-bar bg-warning" style="width: 80%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {

    <style>
        .rating-stars {
            font-size: 1.5rem;
        }

        .progress {
            height: 1rem;
        }

        .progress-group {
            margin-bottom: 1rem;
        }

        .info-box-number .badge {
            font-size: 0.9rem;
        }

        .select2-container--bootstrap4 .select2-selection--multiple .select2-selection__choice {
            background-color: #007bff;
            border: none;
            color: #fff;
            padding: 0.2rem 0.6rem;
        }
        .select2-container--disabled .select2-selection--multiple {
            background-color: #e9ecef !important;
            cursor: not-allowed;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%',
                placeholder: 'Categories',
                allowClear: true
            });
        });
    </script>
}