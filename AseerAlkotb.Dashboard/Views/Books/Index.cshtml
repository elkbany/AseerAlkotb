@model AseerAlkotb.Application.ResponseHandler.ApiResponsePaginated<List<AseerAlkotb.Application.Features.Books.Responses.GetAllBooksPaginatedResponse>>
@using System.Globalization

@{
    ViewData["Title"] = "Books Management";
    var egp = CultureInfo.GetCultureInfo("en-EG");
}
@if (TempData["Success"] != null)
{
     <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
     <div class="alert alert-danger">@TempData["Error"]</div>
}

@functions {
    string ResolveImg(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return Url.Content("~/images/default-book.png");

        // already absolute (http/https)
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return url;

        // normalize relative to app
        if (url.StartsWith("~/"))
            return Url.Content(url);

        if (url.StartsWith("/"))
            return Url.Content("~" + url);

        // fallback
        return Url.Content("~/" + url);
    }
}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Books Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Books</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Statistics Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalCount</h3>
                        <p>Total Books</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-book"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Books List</h3>
                </div>
            </div>
            <div class="card-body">
                <!-- Search and Filter -->
                <div class="row mb-3">
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline">
                            <div class="input-group w-100">
                                <input type="text" name="search" class="form-control"
                                       placeholder="Search by title..." value="@ViewBag.SearchTerm">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-4 text-right">
                        <div class="dropdown">
                            <button type="button"
                                    class="btn btn-outline-secondary dropdown-toggle filter-toggle"
                                    data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-filter"></i> Filter
                            </button>

                            <div class="dropdown-menu dropdown-menu-right dropdown-menu-end p-3 shadow" style="min-width:420px;">
                                <form asp-action="Index" method="get" id="filtersForm">
                                    <input type="hidden" name="pageNumber" value="1" />
                                    <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 10)" />
                                    <input type="hidden" name="search" value="@ViewBag.SearchTerm" />

                                    <!-- Language -->
                                    <div class="form-group mb-2">
                                        <label class="mb-1">Language</label>
                                        <select name="language" class="form-control">
                                            <option value="">All languages</option>
                                            @{
                                                var selectedLang = (AseerAlkotb.Domain.Enums.BookLanguage?)ViewBag.Language;
                                                foreach (var lang in Enum.GetValues(typeof(AseerAlkotb.Domain.Enums.BookLanguage))
                                                .Cast<AseerAlkotb.Domain.Enums.BookLanguage>())
                                                {
                                                    <option value="@lang" selected="@(selectedLang == lang ? "selected" : null)">@lang</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Categories -->
                                    <div class="form-group mb-2">
                                        <label class="mb-1">Categories</label>
                                        <select name="categoryIds" class="form-control select2" multiple>
                                            @{
                                                var selectedCats = (List<int>)ViewBag.CategoryIds ?? new List<int>();
                                                foreach (var c in (IEnumerable<dynamic>)ViewBag.Categories)
                                                {
                                                    bool isSel = selectedCats.Contains((int)c.Id);
                                                    <option value="@c.Id" selected="@(isSel ? "selected" : null)">@c.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Publishers -->
                                    <div class="form-group mb-2">
                                        <label class="mb-1">Publishers</label>
                                        <select name="publisherIds" class="form-control select2" multiple>
                                            @{
                                                var selectedPubs = (List<int>)ViewBag.PublisherIds ?? new List<int>();
                                                foreach (var p in (IEnumerable<dynamic>)ViewBag.Publishers)
                                                {
                                                    bool isSel = selectedPubs.Contains((int)p.Id);
                                                    <option value="@p.Id" selected="@(isSel ? "selected" : null)">@p.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Sort -->
                                    <div class="form-group mb-3">
                                        <label class="mb-1">Sort by</label>
                                        <select name="sortBy" class="form-control">
                                            <option value="">Default</option>
                                            @{
                                                var selectedSort = (AseerAlkotb.Domain.Enums.BookSortOption?)ViewBag.SortBy;
                                                foreach (var opt in Enum.GetValues(typeof(AseerAlkotb.Domain.Enums.BookSortOption))
                                                .Cast<AseerAlkotb.Domain.Enums.BookSortOption>())
                                                {
                                                    <option value="@opt" selected="@(selectedSort == opt ? "selected" : null)">@opt</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="d-flex justify-content-between">
                                        <a class="btn btn-sm btn-link px-0" href="@Url.Action("Index","Books")">Reset</a>
                                        <button type="submit" class="btn btn-sm btn-primary">Apply Filters</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>



                <!-- Books Table -->
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Cover</th>
                                <th>Title</th>
                                <th>ISBN</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Data != null)
                            {
                                @foreach (var item in Model.Data)
                                {
                                    <tr>
                                        <td>
                                             <img src="@ResolveImg(item.CoverImageUrl)" alt="@item.Title" class="img-thumbnail" style="width: 50px;" />
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@item.Title</strong>
                                                <small class="text-muted">@item.CategoryNames?.FirstOrDefault()</small>
                                            </div>
                                        </td>
                                        <td>@item.ISBN</td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@item.Price.ToString("C", egp)</strong>
                                                @if (item.DiscountPercentage > 0)
                                                {
                                                    <small class="text-success">-@(item.DiscountPercentage)%</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.StockQuantity > 0 ? "badge-success" : "badge-danger")">
                                                @(item.StockQuantity > 0 ? $"{item.StockQuantity} in stock" : "Out of stock")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                                @(item.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-controller="Books" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                                       asp-route-pageSize="@ViewBag.PageSize"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-language="@(ViewBag.Language)"
                                       asp-route-categoryIds="@(string.Join(",", (List<int>)ViewBag.CategoryIds))"
                                       asp-route-publisherIds="@(string.Join(",", (List<int>)ViewBag.PublisherIds))"
                                       asp-route-sortBy="@(ViewBag.SortBy)">Previous</a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@ViewBag.PageSize"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-language="@(ViewBag.Language)"
                                       asp-route-categoryIds="@(string.Join(",", (List<int>)ViewBag.CategoryIds))"
                                       asp-route-publisherIds="@(string.Join(",", (List<int>)ViewBag.PublisherIds))"
                                       asp-route-sortBy="@(ViewBag.SortBy)">@i</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                                       asp-route-pageSize="@ViewBag.PageSize"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-language="@(ViewBag.Language)"
                                       asp-route-categoryIds="@(string.Join(",", (List<int>)ViewBag.CategoryIds))"
                                       asp-route-publisherIds="@(string.Join(",", (List<int>)ViewBag.PublisherIds))"
                                       asp-route-sortBy="@(ViewBag.SortBy)">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }

            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            $(function () {
              // خليه مايقفلش الـdropdown لو ضغطت جواه
              $(document).on('click', '.dropdown-menu', function (e) { e.stopPropagation(); });

              // لو Bootstrap مش بيربط تلقائي (سوء نسخة/أدوات)، نعمل fallback يدوي
              $('.filter-toggle').on('click', function (e) {
                // لو BS5/4 شغّالين، الـplugin هيتكفّل. غير كده نعمل toggleClass
                var hasPlugin = typeof bootstrap !== 'undefined' || $.fn.dropdown;
                if (!hasPlugin) {
                  $(this).next('.dropdown-menu').toggleClass('show');
                }
              });

              // لما الـdropdown يفتح فعليًا — فعّل Select2 بداخل القائمة
              $(document).on('shown.bs.dropdown', '.dropdown', function () {
                $('.select2', this).each(function () {
                  // أعدّ التهيئة داخل القائمة المفتوحة عشان المنيو تبان فوق صح
                  $(this).select2({
                    theme: 'bootstrap4',
                    width: '100%',
                    placeholder: 'Select...',
                    allowClear: true,
                    dropdownParent: $(this).closest('.dropdown-menu')
                  });
                });
              });
            });
        </script>
    }
