@model AseerAlkotb.Application.ResponseHandler.ApiResponsePaginated<List<AseerAlkotb.Application.Features.Books.Responses.GetAllBooksPaginatedResponse>>

@{
    ViewData["Title"] = "Books Management";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Books Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Books</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Statistics Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalCount</h3>
                        <p>Total Books</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-book"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <div class="card">
            <div class="card-header border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Books List</h3>
                </div>
            </div>
            <div class="card-body">
                <!-- Search and Filter -->
                <div class="row mb-3">
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline">
                            <div class="input-group w-100">
                                <input type="text" name="Search" class="form-control" placeholder="Search by title,...">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-right">
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle " data-toggle="dropdown">
                                <i class="fas fa-filter"></i> Filter
                            </button>
                            <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" href="#">Active Books</a>
                                <a class="dropdown-item" href="#">Out of Stock</a>
                                <a class="dropdown-item" href="#">Recently Added</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Books Table -->
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Cover</th>
                                <th>Title</th>
                                <th>ISBN</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Data != null)
                            {
                                @foreach (var item in Model.Data)
                                {
                                    <tr>
                                        <td>
                                            <img src="@item.CoverImageUrl" alt="@item.Title" class="img-thumbnail" style="width: 50px; " />
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@item.Title</strong>
                                                <small class="text-muted">@item.CategoryNames?.FirstOrDefault()</small>
                                            </div>
                                        </td>
                                        <td>@item.ISBN</td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@item.Price.ToString("C")</strong>
                                                @if (item.DiscountPercentage > 0)
                                                {
                                                    <small class="text-success">-@(item.DiscountPercentage)%</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.StockQuantity > 0 ? "badge-success" : "badge-danger")">
                                                @(item.StockQuantity > 0 ? $"{item.StockQuantity} in stock" : "Out of stock")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                                @(item.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-controller="Books" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.SearchTerm">Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.SearchTerm">@i</a>
                                </li>
                            }
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.SearchTerm">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        setTimeout(function () { $('.alert').fadeOut('slow'); }, 5000);
    </script>
}