@model AseerAlkotb.Application.Features.Books.Responses.GetBookByIdResponse
@using System.Globalization

@{
    ViewData["Title"] = "Delete Book";

    var egp = CultureInfo.GetCultureInfo("en-EG");

}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Book</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-danger">
                    <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                    Are you sure you want to delete this book? This action cannot be undone.
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div class="row">
                    <div class="col-md-3 text-center">
                        <img src="@($"http://localhost:5234{Model.CoverImageUrl}")" alt="@Model.Title" class="img-fluid rounded" style="max-height: 250px;" />
                    </div>
                    <div class="col-md-9">
                        <h3>@Model.Title</h3>
                        <dl class="row mt-3">
                            <dt class="col-sm-3">ISBN</dt>
                            <dd class="col-sm-9">@Model.ISBN</dd>

                            <dt class="col-sm-3">Author</dt>
                            <dd class="col-sm-9">@ViewBag.Author?.Name</dd>

                            <dt class="col-sm-3">Publisher</dt>
                            <dd class="col-sm-9">@ViewBag.Publisher?.Name</dd>

                            <dt class="col-sm-3">Categories</dt>
                            <dd class="col-sm-9">
                                @if (Model.CategoryNames != null)
                                {
                                    foreach (var category in Model.CategoryNames)
                                    {
                                        <span class="badge badge-info mr-1">@category</span>
                                    }
                                }
                            </dd>

                            <dt class="col-sm-3">Price</dt>
                            <dd class="col-sm-9">
                                @Model.Price.ToString("C", egp)
                                @if (Model.DiscountPercentage > 0)
                                {
                                    <span class="text-success ml-2">-@(Model.DiscountPercentage)%</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Stock</dt>
                            <dd class="col-sm-9">
                                <span class="badge @(Model.StockQuantity > 0 ? "badge-success" : "badge-danger")">
                                    @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                                </span>
                            </dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </dd>
                        </dl>

                        <form asp-action="DeleteConfirmed" class="mt-4">
                            <input type="hidden" asp-for="Id" />
                            <div class="text-right">
                                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?')">
                                    <i class="fas fa-trash mr-1"></i> Delete
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>