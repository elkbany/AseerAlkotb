@model AseerAlkotb.Application.Features.Books.Mapping.AddBookRequest
@{
    ViewData["Title"] = "Add New Book";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add New Book</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data" id="createBookForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-ban"></i> Error!</h5>
                            @TempData["Error"]
                        </div>
                    }
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-check"></i> Success!</h5>
                            @TempData["Success"]
                        </div>
                    }

                    <div class="row">
                        <!-- LEFT: Book Info -->
                        <div class="col-md-8">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Book Information</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <label class="form-label">Book Title (Arabic)</label>
                                        <input asp-for="Title" id="Title" class="form-control" placeholder="أدخل عنوان الكتاب بالعربي" />
                                        <span asp-validation-for="Title" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Book Title (English)</label>
                                        <input name="EnglishTitle" id="EnglishTitle" class="form-control" placeholder="Enter book title in English" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Description (Arabic)</label>
                                        <textarea asp-for="Description" id="Description" class="form-control" rows="4"
                                                  placeholder="أدخل وصف الكتاب بالعربي"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Description (English)</label>
                                        <textarea name="EnglishDescription" id="EnglishDescription" class="form-control" rows="4"
                                                  placeholder="Enter book description in English"></textarea>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="ISBN">ISBN</label>
                                                <input asp-for="ISBN" class="form-control" placeholder="978-..." />
                                                <span asp-validation-for="ISBN" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Language"></label>
                                                <select asp-for="Language" class="form-control"
                                                        asp-items="Html.GetEnumSelectList<AseerAlkotb.Domain.Enums.BookLanguage>()"></select>
                                                <span asp-validation-for="Language" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Price"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text">$</span>
                                                    </div>
                                                    <input asp-for="Price" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Price" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="StockQuantity"></label>
                                                <input asp-for="StockQuantity" type="number" min="0"
                                                       class="form-control" />
                                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="PublishedDate"></label>
                                                <input asp-for="PublishedDate" type="date" class="form-control" />
                                                <span asp-validation-for="PublishedDate" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="PageCount"></label>
                                                <input asp-for="PageCount" type="number" min="1" class="form-control" />
                                                <span asp-validation-for="PageCount" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Format"></label>
                                                <input asp-for="Format" class="form-control"
                                                       placeholder="Paperback, Hardcover, eBook..." />
                                                <span asp-validation-for="Format" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="DiscountPercentage"></label>
                                                <div class="input-group">
                                                    <input asp-for="DiscountPercentage" type="number" min="0" max="100"
                                                           class="form-control" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                                <span asp-validation-for="DiscountPercentage"
                                                      class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Additional Details</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <!-- Author (search style) -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="authorSearch">Author</label>
                                                <div class="input-group">
                                                    @Html.TextBox("authorSearch", null, new
                                                        {
                                                            @class = "form-control",
                                                            placeholder = "Type author name...",
                                                            id = "authorSearch"
                                                        })
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-secondary" type="button"
                                                                id="authorSearchBtn">
                                                            Search
                                                        </button>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="AuthorId" id="AuthorId" />
                                                <div class="small mt-2">
                                                    Selected: <span id="authorSelected"
                                                                    class="font-weight-bold text-primary">None</span>
                                                </div>
                                                <ul id="authorResults" class="list-group mt-2"></ul>
                                                <span asp-validation-for="AuthorId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <!-- Publisher (search style) -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="publisherSearch">Publisher</label>
                                                <div class="input-group">
                                                    @Html.TextBox("publisherSearch", null, new
                                                        {
                                                            @class =
                                                             "form-control",
                                                            placeholder = "Type publisher name...",
                                                            id =
                                                             "publisherSearch"
                                                        })
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-secondary" type="button"
                                                                id="publisherSearchBtn">
                                                            Search
                                                        </button>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="PublisherId" id="PublisherId" />
                                                <div class="small mt-2">
                                                    Selected: <span id="publisherSelected"
                                                                    class="font-weight-bold text-primary">None</span>
                                                </div>
                                                <ul id="publisherResults" class="list-group mt-2"></ul>
                                                <span asp-validation-for="PublisherId" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Categories -->
                                    <div class="form-group">
                                        <label for="categorySearch">Categories</label>
                                        <div class="input-group">
                                            @Html.TextBox("categorySearch", null, new
                                                {
                                                    @class = "form-control",
                                                    placeholder = "Type to search categories...",
                                                    id = "categorySearch"
                                                })
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button" id="categorySearchBtn">Search</button>
                                            </div>
                                        </div>
                                        <div class="small mt-2">
                                            Selected: <span id="categoriesSelected" class="d-inline-block"></span>
                                        </div>
                                        <ul id="categoryResults" class="list-group mt-2"></ul>
                                    </div>

                                    <!-- Hidden select for binding CategoryIds -->
                                    <div class="form-group" style="display:none;">
                                        <label asp-for="CategoryIds" class="control-label"></label>
                                        <select asp-for="CategoryIds" id="categorySelect" class="form-control" multiple></select>
                                        <span asp-validation-for="CategoryIds" class="text-danger"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Cover + Publishing -->
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Cover Image</h3>
                                </div>
                                <div class="card-body">
                                    <div class="text-center mb-3">
                                        <img id="coverPreview" src="/images/default-book-cover.png"
                                             class="img-fluid img-thumbnail" style="max-height:300px;" />
                                    </div>
                                    <div class="form-group">
                                        <div class="custom-file">
                                            <!-- IMPORTANT: name/id must match property CoverImageUrl -->
                                            <input asp-for="CoverImageUrl" type="file" class="custom-file-input"
                                                   id="CoverImageUrl" accept="image/*" />
                                            <label class="custom-file-label" for="CoverImageUrl">Choose file</label>
                                        </div>
                                        <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Publishing Settings</h3>
                                </div>
                                <div class="card-body">
                                    <div class="custom-control custom-switch mb-3">
                                        <input asp-for="IsActive" type="checkbox" class="custom-control-input"
                                               id="isActive">
                                        <label class="custom-control-label" for="isActive">Publish Immediately</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-1"></i> Create Book
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(function () {
            function renderResults($list, data, onClick) {
                $list.empty();
                if (!data || !data.length) {
                    $list.append('<li class="list-group-item text-muted">No results</li>');
                    return;
                }
                data.forEach(item => {
                    const $li = $('<li class="list-group-item list-group-item-action" role="button"></li>');
                    $li.text(item.text);
                    $li.data('item', item);
                    $li.on('click', function () { onClick($(this).data('item')); });
                    $list.append($li);
                });
            }

            function doSearch(url, term, extra, done) {
                const payload = Object.assign({ term: term || '' }, extra || {});
                $.getJSON(url, payload, done);
            }

            // Cover preview
            $('#CoverImageUrl').on('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#coverPreview').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                    const fileName = $(this).val().split('\\').pop();
                    $(this).next('.custom-file-label').text(fileName);
                } else {
                    $('#coverPreview').attr('src', '/images/default-book-cover.png');
                    $(this).next('.custom-file-label').text('Choose file');
                }
            });

                   // Author
        $('#authorSearchBtn').on('click', function () {
            const term = $('#authorSearch').val();
            doSearch('@Url.Action("SearchAuthors", "Books")', term, {}, function (data) {
                renderResults($('#authorResults'), data, function (item) {
                    $('#AuthorId').val(item.id);
                    $('#authorSelected').text(item.text);
                    $('#authorSearch').val(item.text); 
                    $('#authorResults').empty();
                });
            });
        });

        // Publisher
        $('#publisherSearchBtn').on('click', function () {
            const term = $('#publisherSearch').val();
            doSearch('@Url.Action("SearchPublishers", "Books")', term, {}, function (data) {
                renderResults($('#publisherResults'), data, function (item) {
                    $('#PublisherId').val(item.id);
                    $('#publisherSelected').text(item.text);
                    $('#publisherSearch').val(item.text); 
                    $('#publisherResults').empty();
                });
            });
        });


            // Categories
            function addCategoryChip(id, name) {
                const chipId = 'chip-' + id;
                if ($('#' + chipId).length) return;
                const $chip = $('<span class="badge badge-info mr-1 mb-1" id="' + chipId + '"></span>');
                $chip.text(name + ' ×');
                $chip.css('cursor', 'pointer');
                $chip.on('click', function () {
                    $(this).remove();
                    $('#categorySelect option[value="' + id + '"]').remove();
                });
                $('#categoriesSelected').append($chip);
                if ($('#categorySelect option[value="' + id + '"]').length === 0) {
                    const opt = new Option(name, id, true, true);
                    $('#categorySelect').append(opt);
                }
            }

            $('#categorySearchBtn').on('click', function () {
                const term = $('#categorySearch').val();
                doSearch('@Url.Action("SearchCategories", "Books")', term, {}, function (data) {
                    renderResults($('#categoryResults'), data, function (item) {
                        addCategoryChip(item.id, item.text);
                        $('#categorySearch').val(item.text);
                        $('#categoryResults').empty();
                    });
                });
            });

            // Enter key triggers
            function bindEnter(selector, buttonSelector) {
                $(selector).on('keypress', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        $(buttonSelector).click();
                    }
                });
            }
            bindEnter('#authorSearch', '#authorSearchBtn');
            bindEnter('#publisherSearch', '#publisherSearchBtn');
            bindEnter('#categorySearch', '#categorySearchBtn');
            
            // Book Validation Functions
            function validateTitle(title) {
                var errors = [];
                if (!title || title.trim() === '') {
                    errors.push('Book title is required.');
                } else if (title.length > 200) {
                    errors.push('Title must be less than 200 characters.');
                }
                return errors;
            }

            function validateDescription(description) {
                var errors = [];
                if (!description || description.trim() === '') {
                    errors.push('Book description is required.');
                }
                return errors;
            }

            function validateISBN(isbn) {
                var errors = [];
                if (!isbn || isbn.trim() === '') {
                    errors.push('ISBN is required.');
                } else {
                    var isbnPattern = /^\d{10}(\d{3})?$/;
                    if (!isbnPattern.test(isbn.replace(/[^\d]/g, ''))) {
                        errors.push('ISBN must be 10 or 13 digits only.');
                    }
                }
                return errors;
            }

            function validatePrice(price) {
                var errors = [];
                if (!price || price <= 0) {
                    errors.push('Price must be greater than 0.');
                }
                return errors;
            }

            function validateDiscountPercentage(discount) {
                var errors = [];
                if (discount < 0 || discount > 100) {
                    errors.push('Discount percentage must be between 0 and 100.');
                }
                return errors;
            }

            function validatePublishedDate(date) {
                var errors = [];
                if (date && new Date(date) > new Date()) {
                    errors.push('Published date cannot be in the future.');
                }
                return errors;
            }

            function validatePageCount(pageCount) {
                var errors = [];
                if (!pageCount || pageCount <= 0) {
                    errors.push('Page count must be greater than 0.');
                }
                return errors;
            }

            function validateLanguage(language) {
                var errors = [];
                if (!language || language === '') {
                    errors.push('Please select a language.');
                }
                return errors;
            }

            function validateFormat(format) {
                var errors = [];
                if (!format || format.trim() === '') {
                    errors.push('Book format is required.');
                }
                return errors;
            }

            function validateStockQuantity(stock) {
                var errors = [];
                if (stock < 0) {
                    errors.push('Stock quantity cannot be negative.');
                }
                return errors;
            }

            function validateAuthorId(authorId) {
                var errors = [];
                if (!authorId || authorId <= 0) {
                    errors.push('Please select an author.');
                }
                return errors;
            }

            function validatePublisherId(publisherId) {
                var errors = [];
                if (!publisherId || publisherId <= 0) {
                    errors.push('Please select a publisher.');
                }
                return errors;
            }

            function validateCategoryIds() {
                var errors = [];
                var categories = $('#categorySelect option').length;
                if (categories === 0) {
                    errors.push('Please select at least one category.');
                }
                return errors;
            }

            function validateCoverImage(fileInput) {
                var errors = [];
                var file = fileInput.files[0];
                
                if (file) {
                    // Check file size (5MB max)
                    if (file.size > 5 * 1024 * 1024) {
                        errors.push('Cover image size must not exceed 5MB.');
                    }
                    
                    // Check file extension
                    var allowedExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
                    var fileName = file.name.toLowerCase();
                    var hasValidExtension = allowedExtensions.some(ext => fileName.endsWith(ext));
                    
                    if (!hasValidExtension) {
                        errors.push('Only JPG, JPEG, PNG, GIF, and WebP images are allowed.');
                    }
                    
                    // Check content type
                    var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!allowedTypes.includes(file.type.toLowerCase())) {
                        errors.push('Invalid image format.');
                    }
                }
                
                return errors;
            }

            function showValidationErrors(errors) {
                // Clear previous errors
                $('.validation-error').remove();
                
                if (errors.length > 0) {
                    var errorHtml = '<div class="alert alert-danger validation-error"><h5><i class="icon fas fa-exclamation-triangle"></i> Please check the following:</h5><ul>';
                    errors.forEach(function(error) {
                        errorHtml += '<li>' + error + '</li>';
                    });
                    errorHtml += '</ul></div>';
                    
                    $('.card-body').first().prepend(errorHtml);
                    
                    // Scroll to top to show errors
                    $('html, body').animate({
                        scrollTop: $('.validation-error').offset().top - 100
                    }, 500);
                    
                    return false;
                }
                return true;
            }

            // Form validation on submit
            $('#createBookForm').on('submit', function(e) {
                var allErrors = [];
                
                // Validate all fields
                allErrors = allErrors.concat(validateTitle($('#Title').val()));
                allErrors = allErrors.concat(validateDescription($('#Description').val()));
                allErrors = allErrors.concat(validateISBN($('#ISBN').val()));
                allErrors = allErrors.concat(validatePrice(parseFloat($('#Price').val())));
                allErrors = allErrors.concat(validateDiscountPercentage(parseFloat($('#DiscountPercentage').val() || 0)));
                allErrors = allErrors.concat(validatePublishedDate($('#PublishedDate').val()));
                allErrors = allErrors.concat(validatePageCount(parseInt($('#PageCount').val())));
                allErrors = allErrors.concat(validateLanguage($('#Language').val()));
                allErrors = allErrors.concat(validateFormat($('#Format').val()));
                allErrors = allErrors.concat(validateStockQuantity(parseInt($('#StockQuantity').val() || 0)));
                allErrors = allErrors.concat(validateAuthorId(parseInt($('#AuthorId').val())));
                allErrors = allErrors.concat(validatePublisherId(parseInt($('#PublisherId').val())));
                allErrors = allErrors.concat(validateCategoryIds());
                
                var coverImageInput = document.getElementById('CoverImageUrl');
                if (coverImageInput) {
                    allErrors = allErrors.concat(validateCoverImage(coverImageInput));
                }
                
                if (!showValidationErrors(allErrors)) {
                    e.preventDefault();
                }
            });

            // Real-time validation feedback
            $('#Title').on('blur', function() {
                var errors = validateTitle($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });

            $('#Description').on('blur', function() {
                var errors = validateDescription($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });

            $('#ISBN').on('blur', function() {
                var errors = validateISBN($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });

            $('#Price').on('blur', function() {
                var errors = validatePrice(parseFloat($(this).val()));
                var errorSpan = $(this).siblings('.text-danger');
                errorSpan.text(errors.length > 0 ? errors[0] : '');
            });
        });
    </script>
}


