@model AseerAlkotb.Application.Features.Books.Mapping.AddBookRequest
@{
    ViewData["Title"] = "Add New Book";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add New Book</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data" id="createBookForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- LEFT: Book Info -->
                        <div class="col-md-8">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Book Information</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <label asp-for="Title"></label>
                                        <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                                        <span asp-validation-for="Title" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Description"></label>
                                        <textarea asp-for="Description" class="form-control" rows="4"
                                            placeholder="Enter book description"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="ISBN">ISBN</label>
                                                <input asp-for="ISBN" class="form-control" placeholder="978-..." />
                                                <span asp-validation-for="ISBN" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Language"></label>
                                                <select asp-for="Language" class="form-control"
                                                    asp-items="Html.GetEnumSelectList<AseerAlkotb.Domain.Enums.BookLanguage>()"></select>
                                                <span asp-validation-for="Language" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Price"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend"><span
                                                            class="input-group-text">$</span></div>
                                                    <input asp-for="Price" class="form-control" placeholder="0.00" />
                                                </div>
                                                <span asp-validation-for="Price" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="StockQuantity"></label>
                                                <input asp-for="StockQuantity" type="number" min="0"
                                                    class="form-control" />
                                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="PublishedDate"></label>
                                                <input asp-for="PublishedDate" type="date" class="form-control" />
                                                <span asp-validation-for="PublishedDate" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="PageCount"></label>
                                                <input asp-for="PageCount" type="number" min="1" class="form-control" />
                                                <span asp-validation-for="PageCount" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="Format"></label>
                                                <input asp-for="Format" class="form-control"
                                                    placeholder="Paperback, Hardcover, eBook..." />
                                                <span asp-validation-for="Format" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="DiscountPercentage"></label>
                                                <div class="input-group">
                                                    <input asp-for="DiscountPercentage" type="number" min="0" max="100"
                                                        class="form-control" />
                                                    <div class="input-group-append"><span
                                                            class="input-group-text">%</span></div>
                                                </div>
                                                <span asp-validation-for="DiscountPercentage"
                                                    class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Additional Details</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <!-- Author (search style) -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="authorSearch">Author</label>
                                                <div class="input-group">
                                                    @Html.TextBox("authorSearch", null, new { @class = "form-control",
                                                    placeholder = "Type author name...", id = "authorSearch" })
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-secondary" type="button"
                                                            id="authorSearchBtn">Search</button>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="AuthorId" id="AuthorId" />
                                                <div class="small mt-2">Selected: <span id="authorSelected"
                                                        class="font-weight-bold text-primary">None</span></div>
                                                <ul id="authorResults" class="list-group mt-2"></ul>
                                                <span asp-validation-for="AuthorId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <!-- Publisher (search style) -->
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="publisherSearch">Publisher</label>
                                                <div class="input-group">
                                                    @Html.TextBox("publisherSearch", null, new { @class =
                                                                                                        "form-control", placeholder = "Type publisher name...", id =
                                                                                                        "publisherSearch" })
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-secondary" type="button"
                                                            id="publisherSearchBtn">Search</button>
                                                    </div>
                                                </div>
                                                <input type="hidden" asp-for="PublisherId" id="PublisherId" />
                                                <div class="small mt-2">Selected: <span id="publisherSelected"
                                                        class="font-weight-bold text-primary">None</span></div>
                                                <ul id="publisherResults" class="list-group mt-2"></ul>
                                                <span asp-validation-for="PublisherId" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Categories: Parent + Subcategories (search style) -->
                                    <div class="form-group">
                                        <label for="parentCategorySearch">Parent Category</label>
                                        <div class="input-group">
                                            @Html.TextBox("parentCategorySearch", null, new { @class = "form-control",
                                                                                        placeholder = "Type category name...", id = "parentCategorySearch" })
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    id="parentCategorySearchBtn">Search</button>
                                            </div>
                                        </div>
                                        <div class="small mt-2">Selected: <span id="parentCategorySelected"
                                                class="font-weight-bold text-primary">None</span></div>
                                        <ul id="parentCategoryResults" class="list-group mt-2"></ul>
                                    </div>

                                    <div class="form-group">
                                        <label for="subCategorySearch">Subcategories</label>
                                        <div class="input-group">
                                            @Html.TextBox("subCategorySearch", null, new { @class = "form-control",
                                                                                        placeholder = "Type to search subcategories...", id = "subCategorySearch",
                                                                                        disabled = "disabled" })
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                    id="subCategorySearchBtn" disabled>Search</button>
                                            </div>
                                        </div>
                                        <div class="small mt-2">Selected:
                                            <span id="subCategoriesSelected" class="d-inline-block"></span>
                                        </div>
                                        <ul id="subCategoryResults" class="list-group mt-2"></ul>
                                    </div>

                                    <!-- Storage for combined selections to bind to model -->
                                    <div class="form-group" style="display:none;">
                                        <label asp-for="CategoryIds">Categories</label>
                                        <select asp-for="CategoryIds" id="categorySelect" class="form-control"
                                            multiple></select>
                                        <span asp-validation-for="CategoryIds" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Cover + Publishing -->
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Cover Image</h3>
                                </div>
                                <div class="card-body">
                                    <div class="text-center mb-3">
                                        <img id="coverPreview" src="/images/default-book-cover.png"
                                            class="img-fluid img-thumbnail" style="max-height:300px;" />
                                    </div>
                                    <div class="form-group">
                                        <div class="custom-file">
                                            <!-- IMPORTANT: name/id must match property CoverImageUrl -->
                                            <input asp-for="CoverImageUrl" type="file" class="custom-file-input"
                                                id="CoverImageUrl" accept="image/*" />
                                            <label class="custom-file-label" for="CoverImageUrl">Choose file</label>
                                        </div>
                                        <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Publishing Settings</h3>
                                </div>
                                <div class="card-body">
                                    <div class="custom-control custom-switch mb-3">
                                        <input asp-for="IsActive" type="checkbox" class="custom-control-input"
                                            id="isActive">
                                        <label class="custom-control-label" for="isActive">Publish Immediately</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-1"></i> Create Book
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/lib/bs-custom-file-input/bs-custom-file-input.min.js"></script>

    <script>
        $(function () {
            // Enhance file input + preview
            bsCustomFileInput.init();
            $('#CoverImageUrl').on('change', function (e) {
                const f = e.target.files && e.target.files[0];
                if (!f) return;
                const reader = new FileReader();
                reader.onload = function (ev) { $('#coverPreview').attr('src', ev.target.result); };
                reader.readAsDataURL(f);
            });

            // Helpers
            function renderResults($list, data, onClick) {
                $list.empty();
                if (!data || !data.length) {
                    $list.append('<li class="list-group-item text-muted">No results</li>');
                    return;
                }
                data.forEach(item => {
                    const $li = $('<li class="list-group-item list-group-item-action" role="button"></li>');
                    $li.text(item.text);
                    $li.data('item', item);
                    $li.on('click', function () { onClick($(this).data('item')); });
                    $list.append($li);
                });
            }

            function doSearch(url, term, extra, done) {
                const payload = Object.assign({ term: term || '' }, extra || {});
                $.getJSON(url, payload, done);
            }

            // Author search
            $('#authorSearchBtn').on('click', function () {
                const term = $('#authorSearch').val();
                doSearch('@Url.Action("SearchAuthors", "Books")', term, {}, function (data) {
                    renderResults($('#authorResults'), data, function (item) {
                        $('#AuthorId').val(item.id);
                        $('#authorSelected').text(item.text);
                        $('#authorResults').empty();
                    });
                });
            });

            // Publisher search
            $('#publisherSearchBtn').on('click', function () {
                const term = $('#publisherSearch').val();
                doSearch('@Url.Action("SearchPublishers", "Books")', term, {}, function (data) {
                    renderResults($('#publisherResults'), data, function (item) {
                        $('#PublisherId').val(item.id);
                        $('#publisherSelected').text(item.text);
                        $('#publisherResults').empty();
                    });
                });
            });

            // Parent category search
            let parentCategoryId = null;
            $('#parentCategorySearchBtn').on('click', function () {
                const term = $('#parentCategorySearch').val();
                doSearch('@Url.Action("SearchCategories", "Books")', term, {}, function (data) {
                    renderResults($('#parentCategoryResults'), data, function (item) {
                        parentCategoryId = item.id;
                        $('#parentCategorySelected').text(item.text);
                        $('#parentCategoryResults').empty();

                        // Update hidden CategoryIds store parent
                        const $store = $('#categorySelect');
                        $store.find('option[data-role="parent"]').remove();
                        const opt = new Option(item.text, item.id, true, true);
                        $(opt).attr('data-role', 'parent');
                        $store.append(opt).trigger('change');

                        // Enable subcategory search
                        $('#subCategorySearch').prop('disabled', false);
                        $('#subCategorySearchBtn').prop('disabled', false);
                        // Clear previous subcategory chips
                        $('#subCategoriesSelected').empty();
                        // Also remove previous subcategory options from store
                        $store.find('option').each(function () {
                            if (!$(this).is('[data-role="parent"])')) {
                                $(this).remove();
                            }
                        });
                    });
                });
            });

            // Subcategory search (dependent)
            $('#subCategorySearchBtn').on('click', function () {
                const term = $('#subCategorySearch').val();
                if (!parentCategoryId) { return; }
                $.getJSON('@Url.Action("GetSubCategories", "Books")', { categoryId: parentCategoryId, term: term || '' }, function (data) {
                    renderResults($('#subCategoryResults'), data, function (item) {
                        // Add chip
                        const chipId = 'subchip-' + item.id;
                        if ($('#' + chipId).length) { return; }
                        const $chip = $('<span class="badge badge-info mr-1 mb-1" id="' + chipId + '"></span>');
                        $chip.text(item.text + ' ×');
                        $chip.css('cursor', 'pointer');
                        $chip.on('click', function () {
                            // remove chip and option from store
                            $(this).remove();
                            $('#categorySelect option[value="' + item.id + '"]').remove();
                        });
                        $('#subCategoriesSelected').append($chip);

                        // Add to hidden store for CategoryIds
                        const $store = $('#categorySelect');
                        if ($store.find('option[value="' + item.id + '"]').length === 0) {
                            const opt = new Option(item.text, item.id, true, true);
                            $store.append(opt);
                            $store.trigger('change');
                        }

                        $('#subCategoryResults').empty();
                    });
                });
            });

            // Optional: Enter key triggers search on the active textbox
            function bindEnter(selector, buttonSelector) {
                $(selector).on('keypress', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        $(buttonSelector).click();
                    }
                });
            }
            bindEnter('#authorSearch', '#authorSearchBtn');
            bindEnter('#publisherSearch', '#publisherSearchBtn');
            bindEnter('#parentCategorySearch', '#parentCategorySearchBtn');
            bindEnter('#subCategorySearch', '#subCategorySearchBtn');
        });
    </script>
}
