@using AseerAlkotb.Dashboard.Helpers
@model AseerAlkotb.Application.Features.Orders.Responses.GetOrderByAdminByTrackingNumberResponse
@{
    ViewData["Title"] = $"Order Details - {Model.TrackingNumber}";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index")">
                                    <i class="fas fa-shopping-cart me-1"></i>Orders
                                </a>
                            </li>
                            <li class="breadcrumb-item active">Order Details</li>
                        </ol>
                    </nav>
                    <h1 class="h3 mb-0 text-gray-800">
                        Order Details
                    </h1>
                    <p class="text-muted mb-0">Tracking Number: <code>@Model.TrackingNumber</code></p>
                </div>
                <div>
                    <button class="btn btn-outline-primary me-2" onclick="window.print()">
                        <i class="fas fa-print me-1"></i>Print
                    </button>
                    <button class="btn btn-outline-warning me-2" 
                            onclick="openStatusUpdateModal(@Model.Id, '@Model.TrackingNumber', '@Model.OrderStatus', '@Model.UserName')">
                        <i class="fas fa-edit me-1"></i>Update Status
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Status Timeline -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-route me-2"></i>Order Status Timeline
                    </h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item @(Model.OrderStatus == AseerAlkotb.Domain.Enums.OrderStatus.Pending ? "active" : Model.OrderStatus > AseerAlkotb.Domain.Enums.OrderStatus.Pending ? "completed" : "")">
                            <div class="timeline-marker">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Order Placed</h6>
                                <p class="text-muted small">@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.OrderStatus == AseerAlkotb.Domain.Enums.OrderStatus.Approved ? "active" : Model.OrderStatus > AseerAlkotb.Domain.Enums.OrderStatus.Approved ? "completed" : "")">
                            <div class="timeline-marker">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Order Approved</h6>
                                <p class="text-muted small">
                                    @if (Model.OrderStatus >= AseerAlkotb.Domain.Enums.OrderStatus.Approved)
                                    {
                                        @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>Pending approval</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.OrderStatus == AseerAlkotb.Domain.Enums.OrderStatus.Shipped ? "active" : Model.OrderStatus > AseerAlkotb.Domain.Enums.OrderStatus.Shipped ? "completed" : "")">
                            <div class="timeline-marker">
                                <i class="fas fa-shipping-fast"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Order Shipped</h6>
                                <p class="text-muted small">
                                    @if (Model.OrderStatus >= AseerAlkotb.Domain.Enums.OrderStatus.Shipped)
                                    {
                                        @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>In transit</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="timeline-item @(Model.OrderStatus == AseerAlkotb.Domain.Enums.OrderStatus.Delivered ? "active completed" : "")">
                            <div class="timeline-marker">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Order Delivered</h6>
                                <p class="text-muted small">
                                    @if (Model.OrderStatus == AseerAlkotb.Domain.Enums.OrderStatus.Delivered)
                                    {
                                        @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>Successfully delivered</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Order Information -->
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-shopping-bag me-2"></i>Order Items
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Book</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Books != null && Model.Books.Any())
                                {
                                    @foreach (var book in Model.Books)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-book"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">@book.Title</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@book.Quantity</span>
                                            </td>
                                            <td class="text-end font-weight-bold">
                                                @((book.Price * book.Quantity).ToString("C", new System.Globalization.CultureInfo("ar-EG")))
                                            </td>
                                            <td class="text-end">
                                                @book.Price.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
                                            </td>
                                            <td class="text-end font-weight-bold">
                                                @book.Price.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No items found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Information -->
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-credit-card me-2"></i>Payment Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Payment Method</label>
                                <div class="d-flex align-items-center">
                                    <i class="@ViewHelper.GetPaymentMethodIcon(Model.PaymentMethod) me-2 text-muted"></i>
                                    <span>@ViewHelper.GetPaymentMethodDisplayName(Model.PaymentMethod)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Payment Status</label>
                                <div>
                                    <span class="badge @ViewHelper.GetPaymentStatusBadgeClass(Model.PaymentStatus)">
                                        @Model.PaymentStatus
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Order Summary -->
                    <div class="border-top pt-3">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span class="float-end">@Model.TotalAmount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted">Shipping:</span>
                                    <span class="float-end">@Model.ShippingCost.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</span>
                                </div>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <div class="mb-2 text-success">
                                        <span>Discount:</span>
                                        <span class="float-end">-@Model.DiscountAmount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</span>
                                    </div>
                                }
                                <hr>
                                <div class="h5 mb-0">
                                    <strong class="text-success">
                                        Total: @Model.FinalAmount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Shipping Information -->
        <div class="col-lg-4">
            <!-- Customer Information -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            @if (!string.IsNullOrEmpty(Model.UserName))
                            {
                                <span class="h4 mb-0">@Model.UserName.Substring(0, 1).ToUpper()</span>
                            }
                            else
                            {
                                <i class="fas fa-user fa-2x"></i>
                            }
                        </div>
                        <h5 class="mt-2 mb-0">@(Model.UserName ?? "Unknown Customer")</h5>
                    </div>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-map-marker-alt me-2"></i>Shipping Address
                    </h6>
                </div>
                <div class="card-body">
                    <address class="mb-0">
                        <i class="fas fa-map-marker-alt text-muted me-2"></i>
                        @Model.CityName, @Model.GovernorateName.ToString().Replace("_", " ")<br>
                        <small class="text-muted">Egypt</small>
                    </address>
                </div>
            </div>

            <!-- Order Status -->
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle me-2"></i>Order Status
                    </h6>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <span class="badge @ViewHelper.GetStatusBadgeClass(Model.OrderStatus) p-3 fs-6">
                            <i class="@ViewHelper.GetStatusIcon(Model.OrderStatus) me-2"></i>
                            @Model.OrderStatus
                        </span>
                        <div class="mt-3">
                            <small class="text-muted">
                                Last updated: @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal (reuse from Index) -->
<div class="modal fade" id="statusUpdateModal" tabindex="-1" aria-labelledby="statusUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusUpdateModalLabel">
                    <i class="fas fa-edit me-2"></i>Update Order Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="statusUpdateForm">
                    <input type="hidden" id="orderId" />
                    <div class="mb-3">
                        <label for="orderInfo" class="form-label">Order Information</label>
                        <p id="orderInfo" class="form-control-plaintext text-muted"></p>
                    </div>
                    <div class="mb-3">
                        <label for="currentStatus" class="form-label">Current Status</label>
                        <p id="currentStatus" class="form-control-plaintext"></p>
                    </div>
                    <div class="mb-3">
                        <label for="newStatus" class="form-label">New Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="newStatus" required>
                            <option value="">Select new status...</option>
                            @foreach (var status in ViewBag.OrderStatuses as AseerAlkotb.Domain.Enums.OrderStatus[])
                            {
                                var statusValue = (int)status;
                                <option value="@statusValue">@status</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateOrderStatus()">
                    <i class="fas fa-save me-1"></i>Update Status
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding: 0;
            list-style: none;
        }

        .timeline::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 30px;
            width: 2px;
            background: #dee2e6;
        }

        .timeline-item {
            position: relative;
            padding: 0 0 20px 60px;
        }

        .timeline-marker {
            position: absolute;
            left: 22px;
            top: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            color: #6c757d;
        }

        .timeline-item.completed .timeline-marker {
            background: #28a745;
            color: white;
        }

        .timeline-item.active .timeline-marker {
            background: #007bff;
            color: white;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%% { box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.7); }
            70%% { box-shadow: 0 0 0 10px rgba(0, 123, 255, 0); }
            100%% { box-shadow: 0 0 0 0 rgba(0, 123, 255, 0); }
        }

        .timeline-content h6 {
            margin: 0 0 5px 0;
            font-weight: 600;
        }

        .timeline-item.completed .timeline-content h6 {
            color: #28a745;
        }

        .timeline-item.active .timeline-content h6 {
            color: #007bff;
        }
    </style>
}

@section Scripts {
    <script src="~/js/orders.js"></script>
}