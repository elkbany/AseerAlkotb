@model AseerAlkotb.Application.Features.Orders.Responses.GetAllOrdersPaginatedResponse

<tr data-order-id="@Model.Id">
    <td>
        <strong class="text-primary">#@Model.Id</strong>
    </td>
    <td>
        <div class="d-flex align-items-center">
            <div class="avatar avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    @Model.UserName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <i class="fas fa-user"></i>
                }
            </div>
            <div>
                <div class="font-weight-bold">@(Model.UserName ?? "Unknown")</div>
            </div>
        </div>
    </td>
    <td>
        <code class="bg-light p-1 rounded">@Model.TrackingNumber</code>
    </td>
    <td>
        <span class="badge @GetStatusBadgeClass(Model.OrderStatus) order-status" data-status="@((int)Model.OrderStatus)">
            <i class="@GetStatusIcon(Model.OrderStatus) me-1"></i>
            @Model.OrderStatus
        </span>
    </td>
    <td>
        <div class="d-flex align-items-center">
            <i class="@GetPaymentMethodIcon(Model.PaymentMethod) me-2 text-muted"></i>
            <span>@Model.PaymentMethod</span>
        </div>
    </td>
    <td>
        <strong class="text-success">
            @Model.FinalAmount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))
        </strong>
    </td>
    <td>
        <div>
            <div class="font-weight-bold">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
            <small class="text-muted">@Model.OrderDate.ToString("HH:mm")</small>
        </div>
    </td>
    <td>
        <div>
            <i class="fas fa-map-marker-alt text-muted me-1"></i>
            <span class="small">@Model.City, @Model.Governorate.ToString().Replace("_", " ")</span>
        </div>
    </td>
    <td>
        <div class="btn-group" role="group">
            <a href="@Url.Action("Details", new { id = Model.Id })" 
               class="btn btn-sm btn-outline-primary" 
               title="View Details">
                <i class="fas fa-eye"></i>
            </a>
            <button type="button" 
                    class="btn btn-sm btn-outline-warning" 
                    onclick="openStatusUpdateModal(@Model.Id, '@Model.TrackingNumber', '@Model.OrderStatus', '@Model.UserName')"
                    title="Update Status">
                <i class="fas fa-edit"></i>
            </button>
            <div class="btn-group" role="group">
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        title="More Actions">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("Print", new { id = Model.Id })">
                            <i class="fas fa-print me-2"></i>Print Order
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-info" href="#" onclick="copyTrackingNumber('@Model.TrackingNumber')">
                            <i class="fas fa-copy me-2"></i>Copy Tracking Number
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </td>
</tr>

@functions {
    public string GetStatusBadgeClass(AseerAlkotb.Domain.Enums.OrderStatus status)
    {
        return status switch
        {
            AseerAlkotb.Domain.Enums.OrderStatus.Pending => "bg-warning",
            AseerAlkotb.Domain.Enums.OrderStatus.Approved => "bg-info",
            AseerAlkotb.Domain.Enums.OrderStatus.Shipped => "bg-primary",
            AseerAlkotb.Domain.Enums.OrderStatus.Delivered => "bg-success",
            AseerAlkotb.Domain.Enums.OrderStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public string GetStatusIcon(AseerAlkotb.Domain.Enums.OrderStatus status)
    {
        return status switch
        {
            AseerAlkotb.Domain.Enums.OrderStatus.Pending => "fas fa-clock",
            AseerAlkotb.Domain.Enums.OrderStatus.Approved => "fas fa-check",
            AseerAlkotb.Domain.Enums.OrderStatus.Shipped => "fas fa-shipping-fast",
            AseerAlkotb.Domain.Enums.OrderStatus.Delivered => "fas fa-check-circle",
            AseerAlkotb.Domain.Enums.OrderStatus.Cancelled => "fas fa-times-circle",
            _ => "fas fa-question-circle"
        };
    }

    public string GetPaymentMethodIcon(AseerAlkotb.Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery => "fas fa-money-bill-wave",
            AseerAlkotb.Domain.Enums.PaymentMethod.Card => "fas fa-credit-card",
            AseerAlkotb.Domain.Enums.PaymentMethod.MobileWallet => "fas fa-mobile-alt",
            _ => "fas fa-question-circle"
        };
    }
}