@model AseerAlkotb.Application.Features.Authors.Requests.AddAuthorRequest
@{
    ViewData["Title"] = "Add New Author";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add New Author</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Authors</a></li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data" id="createAuthorForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-ban"></i> Error!</h5>
                            @TempData["Error"]
                        </div>
                    }
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-check"></i> Success!</h5>
                            @TempData["Success"]
                        </div>
                    }

                    <div class="row">
                        <!-- LEFT: Author Info -->
                        <div class="col-md-8">
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h3 class="card-title">Author Information</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <label class="form-label">Author Name (Arabic)</label>
                                        <input asp-for="Name" id="Name" class="form-control" placeholder="أدخل اسم المؤلف بالعربي" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Author Name (English)</label>
                                        <input name="EnglishName" id="EnglishName" class="form-control" placeholder="Enter author name in English" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Biography (Arabic)</label>
                                        <textarea asp-for="Bio" id="Bio" class="form-control" rows="4"
                                            placeholder="أدخل السيرة الذاتية بالعربي"></textarea>
                                        <span asp-validation-for="Bio" class="text-danger"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Biography (English)</label>
                                        <textarea name="EnglishBio" id="EnglishBio" class="form-control" rows="4"
                                            placeholder="Enter author biography in English"></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Country</label>
                                        @Html.DropDownListFor(m => m.CountryCode,
                                                 (IEnumerable<SelectListItem>)ViewBag.CountryList,
                                                 "-- اختر الدولة --",
                                                 new { @class = "form-control", id = "CountryCode" })
                                        <span asp-validation-for="CountryCode" class="text-danger"></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Author Image -->
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Author Image</h3>
                                </div>
                                <div class="card-body">
                                    <div class="form-group">
                                        <div class="text-center mb-3">
                                            <img id="imagePreview" src="~/images/default-user.png" class="img-circle" 
                                                style="width: 150px; height: 150px; object-fit: cover;" />
                                        </div>
                                        <div class="custom-file">
                                            <input type="file" asp-for="Image" class="custom-file-input" id="imageInput" 
                                                accept="image/*" />
                                            <label class="custom-file-label" for="imageInput">Choose image...</label>
                                        </div>
                                        <small class="form-text text-muted">Supported formats: JPG, PNG. Max size: 5MB</small>
                                        <span asp-validation-for="Image" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mt-4">
                                <div class="card-header">
                                    <h3 class="card-title">Preview</h3>
                                </div>
                                <div class="card-body">
                                    <div class="text-center mb-3">
                                        <h4 id="previewName" class="text-muted">Author Name</h4>
                                        <p id="previewCountry" class="text-muted">Country</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12 text-right">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Author
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ml-2">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Image preview
            $(document).on("change", "#imageInput", function() {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $("#imagePreview").attr("src", e.target.result);
                }
                reader.readAsDataURL(this.files[0]);
            });

            // Update preview
            $(document).on("input", "#Name", function() {
                $("#previewName").text($(this).val() || "Author Name");
            });

            $(document).on("change", "#CountryCode", function() {
                var countryCode = $(this).find("option:selected").text();
                $("#previewCountry").text(countryCode || "Country");
            });

            // Validation functions
            function validateName(name) {
                var errors = [];
                
                if (!name || name.trim() === '') {
                    errors.push('Author name is required.');
                } else {
                    if (name.length < 2 || name.length > 200) {
                        errors.push('Author name must be between 2 and 200 characters.');
                    }
                    
                    var namePattern = /^[a-zA-Z\u0600-\u06FF\s]+$/;
                    if (!namePattern.test(name)) {
                        errors.push('Author name must contain only letters and spaces.');
                    }
                }
                
                return errors;
            }

            function validateBio(bio) {
                var errors = [];
                
                if (!bio || bio.trim() === '') {
                    errors.push('Author biography is required.');
                } else if (bio.length < 10 || bio.length > 2000) {
                    errors.push('Biography must be between 10 and 2000 characters.');
                }
                
                return errors;
            }

            function validateImage(fileInput) {
                var errors = [];
                var file = fileInput.files[0];
                
                if (file) {
                    // Check file size (5MB max)
                    if (file.size > 5 * 1024 * 1024) {
                        errors.push('Image size must not exceed 5MB.');
                    }
                    
                    // Check file extension
                    var allowedExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];
                    var fileName = file.name.toLowerCase();
                    var hasValidExtension = allowedExtensions.some(ext => fileName.endsWith(ext));
                    
                    if (!hasValidExtension) {
                        errors.push('Only JPG, JPEG, PNG, GIF, and WebP images are allowed.');
                    }
                    
                    // Check content type
                    var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                    if (!allowedTypes.includes(file.type.toLowerCase())) {
                        errors.push('Invalid image format.');
                    }
                }
                
                return errors;
            }

            function validateCountryCode(countryCode) {
                var errors = [];
                
                if (!countryCode || countryCode === '') {
                    errors.push('Please select a country.');
                }
                
                return errors;
            }

            function showValidationErrors(errors) {
                // Clear previous errors
                $('.validation-error').remove();
                
                if (errors.length > 0) {
                    var errorHtml = '<div class="alert alert-danger validation-error"><h5><i class="icon fas fa-exclamation-triangle"></i> Please check the following:</h5><ul>';
                    errors.forEach(function(error) {
                        errorHtml += '<li>' + error + '</li>';
                    });
                    errorHtml += '</ul></div>';
                    
                    $('.card-body').first().prepend(errorHtml);
                    
                    // Scroll to top to show errors
                    $('html, body').animate({
                        scrollTop: $('.validation-error').offset().top - 100
                    }, 500);
                    
                    return false;
                }
                return true;
            }

            // Form validation on submit
            $("#createAuthorForm").on("submit", function(e) {
                var allErrors = [];
                
                // Validate name
                var nameErrors = validateName($("#Name").val());
                allErrors = allErrors.concat(nameErrors);
                
                // Validate bio
                var bioErrors = validateBio($("#Bio").val());
                allErrors = allErrors.concat(bioErrors);
                
                // Validate image
                var imageErrors = validateImage(document.getElementById('imageInput'));
                allErrors = allErrors.concat(imageErrors);
                
                // Validate country code
                var countryErrors = validateCountryCode($("#CountryCode").val());
                allErrors = allErrors.concat(countryErrors);
                
                if (!showValidationErrors(allErrors)) {
                    e.preventDefault();
                }
            });

            // Real-time validation feedback
            $("#Name").on('blur', function() {
                var errors = validateName($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                if (errors.length > 0) {
                    errorSpan.text(errors[0]);
                } else {
                    errorSpan.text('');
                }
            });

            $("#Bio").on('blur', function() {
                var errors = validateBio($(this).val());
                var errorSpan = $(this).siblings('.text-danger');
                if (errors.length > 0) {
                    errorSpan.text(errors[0]);
                } else {
                    errorSpan.text('');
                }
            });

            $("#imageInput").on('change', function() {
                var errors = validateImage(this);
                var errorSpan = $(this).parent().siblings('.text-danger');
                if (errors.length > 0) {
                    errorSpan.text(errors[0]);
                } else {
                    errorSpan.text('');
                }
            });
        });
    </script>
}