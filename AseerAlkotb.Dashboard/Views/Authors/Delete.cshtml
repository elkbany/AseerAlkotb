@model AseerAlkotb.Application.Features.Authors.Responses.GetAuthorByIdResponse
@{
    ViewData["Title"] = "Delete Author";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Delete Author</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Authors</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title">Confirm Deletion</h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h4><i class="fas fa-exclamation-triangle"></i> Warning!</h4>
                            <p>Are you sure you want to delete this author? This action cannot be undone.</p>
                        </div>

                        <div class="row">
                            <div class="col-md-4 text-center mb-4">
                                <img src="@Model.ImageUrl ?? "/images/default-user.png"" class="img-circle" 
                                    style="width: 150px; height: 150px; object-fit: cover;" />
                            </div>
                            <div class="col-md-8">
                                <dl class="row">
                                    <dt class="col-sm-3">Name:</dt>
                                    <dd class="col-sm-9">@Model.Name</dd>

                                    <dt class="col-sm-3">Country:</dt>
                                    <dd class="col-sm-9">@Model.CountryCode</dd>

                                    <dt class="col-sm-3">Rating:</dt>
                                    <dd class="col-sm-9">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(Model.Rating))
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-warning"></i>
                                            }
                                        }
                                        <span class="ml-1">@Model.Rating.ToString("0.0")</span>
                                    </dd>

                                    <dt class="col-sm-3">Books Count:</dt>
                                    <dd class="col-sm-9">@Model.Books.Count</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-12 text-right">
                                <form asp-action="DeleteConfirmed">
                                    <input type="hidden" asp-for="Id" />
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-trash"></i> Delete Author
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary ml-2">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>