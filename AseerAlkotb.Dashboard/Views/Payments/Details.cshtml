@model AseerAlkotb.Application.Features.Payments.Responses.GetPaymentByIdResponse
@{
    ViewData["Title"] = $"Payment Details - {Model.TransactionId}";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("Index")">
                                    <i class="fas fa-credit-card me-1"></i>Payments
                                </a>
                            </li>
                            <li class="breadcrumb-item active">Payment Details</li>
                        </ol>
                    </nav>
                    <h1 class="h3 mb-0 text-gray-800">
                        Payment Details
                    </h1>
                    <p class="text-muted mb-0">Transaction ID: <code>@Model.TransactionId</code></p>
                </div>
                <div>
                    <button class="btn btn-outline-primary me-2" onclick="window.print()">
                        <i class="fas fa-print me-1"></i>Print
                    </button>
                    <button class="btn btn-outline-warning me-2" 
                            onclick="openStatusUpdateModal(@Model.Id, '@Model.TransactionId', '@Model.Status', '@Model.CustomerName')">
                        <i class="fas fa-edit me-1"></i>Update Status
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Payments
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Status Overview -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle me-2"></i>Payment Status Overview
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <div class="mb-3">
                                <span class="badge @GetStatusBadgeClass(Model.Status) p-3 fs-5">
                                    <i class="@GetStatusIcon(Model.Status) me-2"></i>
                                    @Model.Status
                                </span>
                            </div>
                            <small class="text-muted">Current Status</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-3">
                                <h4 class="text-success">@Model.Amount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</h4>
                            </div>
                            <small class="text-muted">Amount</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-3">
                                <i class="@GetPaymentMethodIcon(Model.PaymentMethod) fa-2x text-primary"></i>
                            </div>
                            <small class="text-muted">@GetPaymentMethodDisplayName(Model.PaymentMethod)</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="mb-3">
                                <strong>@Model.PaymentDate.ToString("MMM dd, yyyy HH:mm")</strong>
                            </div>
                            <small class="text-muted">Payment Date</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Payment Information -->
        <div class="col-lg-8">
            <!-- Transaction Details -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-receipt me-2"></i>Transaction Details
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-muted">Payment ID:</td>
                                    <td>#@Model.Id</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Transaction ID:</td>
                                    <td>
                                        <code class="bg-light p-2 rounded">@Model.TransactionId</code>
                                        <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@Model.TransactionId')">
                                            <i class="fas fa-copy"></i> Copy
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Order ID:</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Orders", new { id = Model.OrderId })" class="text-decoration-none">
                                            #@Model.OrderId <i class="fas fa-external-link-alt ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Amount:</td>
                                    <td><strong class="text-success fs-5">@Model.Amount.ToString("C", new System.Globalization.CultureInfo("ar-EG"))</strong></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Currency:</td>
                                    <td>@Model.Currency</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Payment Method:</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="@GetPaymentMethodIcon(Model.PaymentMethod) me-2 text-muted"></i>
                                            <span>@GetPaymentMethodDisplayName(Model.PaymentMethod)</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Payment Date:</td>
                                    <td>@Model.PaymentDate.ToString("MMMM dd, yyyy 'at' HH:mm")</td>
                                </tr>
                                @if (Model.PaymobOrderId.HasValue)
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">Paymob Order ID:</td>
                                        <td>
                                            <code class="bg-light p-2 rounded">@Model.PaymobOrderId</code>
                                            <button class="btn btn-sm btn-outline-primary ms-2" onclick="viewPaymobDetails(@Model.PaymobOrderId)">
                                                <i class="fas fa-external-link-alt"></i> View in Paymob
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">Admin Notes:</td>
                                        <td>
                                            <div class="alert alert-info mb-0">
                                                <i class="fas fa-sticky-note me-2"></i>
                                                @Model.AdminNotes
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Timeline -->
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-history me-2"></i>Payment Timeline
                    </h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item completed">
                            <div class="timeline-marker">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Payment Initialized</h6>
                                <p class="text-muted small">@Model.PaymentDate.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                        </div>
                        @if (Model.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Processing)
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Processing</h6>
                                    <p class="text-muted small">Payment is being processed</p>
                                </div>
                            </div>
                        }
                        @if (Model.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Paid)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Payment Successful</h6>
                                    <p class="text-muted small">Payment completed successfully</p>
                                </div>
                            </div>
                        }
                        @if (Model.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Failed)
                        {
                            <div class="timeline-item failed">
                                <div class="timeline-marker">
                                    <i class="fas fa-times"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Payment Failed</h6>
                                    <p class="text-muted small">Payment could not be processed</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Order Information -->
        <div class="col-lg-4">
            <!-- Customer Information -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user me-2"></i>Customer Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            @if (!string.IsNullOrEmpty(Model.CustomerName))
                            {
                                <span class="h4 mb-0">@Model.CustomerName.Substring(0, 1).ToUpper()</span>
                            }
                            else
                            {
                                <i class="fas fa-user fa-2x"></i>
                            }
                        </div>
                        <h5 class="mt-2 mb-0">@(Model.CustomerName ?? "Unknown Customer")</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-borderless table-sm">
                            <tbody>
                                <tr>
                                    <td class="text-muted">
                                        <i class="fas fa-envelope me-2"></i>Email:
                                    </td>
                                    <td>
                                        <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                                {
                                    <tr>
                                        <td class="text-muted">
                                            <i class="fas fa-phone me-2"></i>Phone:
                                        </td>
                                        <td>
                                            <a href="tel:@Model.CustomerPhone">@Model.CustomerPhone</a>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td class="text-muted">
                                        <i class="fas fa-id-badge me-2"></i>User ID:
                                    </td>
                                    <td>#@Model.UserId</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-warning" 
                                onclick="openStatusUpdateModal(@Model.Id, '@Model.TransactionId', '@Model.Status', '@Model.CustomerName')">
                            <i class="fas fa-edit me-2"></i>Update Status
                        </button>
                        <button class="btn btn-outline-primary" onclick="window.print()">
                            <i class="fas fa-print me-2"></i>Print Receipt
                        </button>
                        <button class="btn btn-outline-info" onclick="copyToClipboard('@Model.TransactionId')">
                            <i class="fas fa-copy me-2"></i>Copy Transaction ID
                        </button>
                        @if (Model.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Paid)
                        {
                            <button class="btn btn-outline-warning" onclick="initiateRefund(@Model.Id)">
                                <i class="fas fa-undo me-2"></i>Initiate Refund
                            </button>
                        }
                        @if (Model.PaymentMethod != AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery)
                        {
                            <button class="btn btn-outline-success" onclick="viewPaymobDetails(@Model.PaymobOrderId)">
                                <i class="fas fa-external-link-alt me-2"></i>View in Paymob
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal (reuse from Index) -->
<div class="modal fade" id="statusUpdateModal" tabindex="-1" aria-labelledby="statusUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusUpdateModalLabel">
                    <i class="fas fa-edit me-2"></i>Update Payment Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="statusUpdateForm">
                    <input type="hidden" id="paymentId" />
                    <div class="mb-3">
                        <label for="paymentInfo" class="form-label">Payment Information</label>
                        <p id="paymentInfo" class="form-control-plaintext text-muted"></p>
                    </div>
                    <div class="mb-3">
                        <label for="currentStatus" class="form-label">Current Status</label>
                        <p id="currentStatus" class="form-control-plaintext"></p>
                    </div>
                    <div class="mb-3">
                        <label for="newStatus" class="form-label">New Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="newStatus" required>
                            <option value="">Select new status...</option>
                            @foreach (var status in ViewBag.PaymentStatuses as AseerAlkotb.Domain.Enums.PaymentStatus[])
                            {
                                var statusValue = (int)status;
                                <option value="@statusValue">@status</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="adminNotes" class="form-label">Admin Notes</label>
                        <textarea class="form-control" id="adminNotes" rows="3" placeholder="Optional notes for this status change..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updatePaymentStatus()">
                    <i class="fas fa-save me-1"></i>Update Status
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding: 0;
            list-style: none;
        }

        .timeline::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 30px;
            width: 2px;
            background: #dee2e6;
        }

        .timeline-item {
            position: relative;
            padding: 0 0 20px 60px;
        }

        .timeline-marker {
            position: absolute;
            left: 22px;
            top: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            color: #6c757d;
        }

        .timeline-item.completed .timeline-marker {
            background: #28a745;
            color: white;
        }

        .timeline-item.active .timeline-marker {
            background: #007bff;
            color: white;
            animation: pulse 2s infinite;
        }

        .timeline-item.failed .timeline-marker {
            background: #dc3545;
            color: white;
        }

        @@keyframes pulse {
            0%% { box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.7); }
            70%% { box-shadow: 0 0 0 10px rgba(0, 123, 255, 0); }
            100%% { box-shadow: 0 0 0 0 rgba(0, 123, 255, 0); }
        }

        .timeline-content h6 {
            margin: 0 0 5px 0;
            font-weight: 600;
        }

        .timeline-item.completed .timeline-content h6 {
            color: #28a745;
        }

        .timeline-item.active .timeline-content h6 {
            color: #007bff;
        }

        .timeline-item.failed .timeline-content h6 {
            color: #dc3545;
        }
    </style>
}

@section Scripts {
    <script src="~/js/payments.js"></script>
}

@functions {
    public string GetStatusBadgeClass(AseerAlkotb.Domain.Enums.PaymentStatus status)
    {
        return status switch
        {
            AseerAlkotb.Domain.Enums.PaymentStatus.Pending => "bg-warning",
            AseerAlkotb.Domain.Enums.PaymentStatus.Processing => "bg-info",
            AseerAlkotb.Domain.Enums.PaymentStatus.Paid => "bg-success",
            AseerAlkotb.Domain.Enums.PaymentStatus.Failed => "bg-danger",
            AseerAlkotb.Domain.Enums.PaymentStatus.Cancelled => "bg-secondary",
            AseerAlkotb.Domain.Enums.PaymentStatus.Refunded => "bg-dark",
            AseerAlkotb.Domain.Enums.PaymentStatus.PartiallyRefunded => "bg-primary",
            _ => "bg-secondary"
        };
    }

    public string GetStatusIcon(AseerAlkotb.Domain.Enums.PaymentStatus status)
    {
        return status switch
        {
            AseerAlkotb.Domain.Enums.PaymentStatus.Pending => "fas fa-clock",
            AseerAlkotb.Domain.Enums.PaymentStatus.Processing => "fas fa-spinner fa-spin",
            AseerAlkotb.Domain.Enums.PaymentStatus.Paid => "fas fa-check-circle",
            AseerAlkotb.Domain.Enums.PaymentStatus.Failed => "fas fa-times-circle",
            AseerAlkotb.Domain.Enums.PaymentStatus.Cancelled => "fas fa-ban",
            AseerAlkotb.Domain.Enums.PaymentStatus.Refunded => "fas fa-undo",
            AseerAlkotb.Domain.Enums.PaymentStatus.PartiallyRefunded => "fas fa-undo-alt",
            _ => "fas fa-question-circle"
        };
    }

    public string GetPaymentMethodIcon(AseerAlkotb.Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery => "fas fa-money-bill-wave",
            AseerAlkotb.Domain.Enums.PaymentMethod.Card => "fas fa-credit-card",
            AseerAlkotb.Domain.Enums.PaymentMethod.MobileWallet => "fas fa-mobile-alt",
            _ => "fas fa-question-circle"
        };
    }

    public string GetPaymentMethodDisplayName(AseerAlkotb.Domain.Enums.PaymentMethod method)
    {
        return method switch
        {
            AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery => "Cash on Delivery",
            AseerAlkotb.Domain.Enums.PaymentMethod.Card => "Credit/Debit Card",
            AseerAlkotb.Domain.Enums.PaymentMethod.MobileWallet => "Mobile Wallet",
            _ => method.ToString()
        };
    }
}