@model List<AseerAlkotb.Application.Features.Payments.Responses.GetAllPaymentsPaginatedResponse>
@{
    ViewData["Title"] = "Payment Management";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-credit-card me-2"></i>Payment Management
                    </h1>
                    <p class="text-muted mb-0">Monitor and manage all payment transactions</p>
                </div>
                <div>
                    <button class="btn btn-outline-primary me-2" onclick="exportPayments()">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                    <button class="btn btn-primary" onclick="refreshPayments()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-filter me-2"></i>Filters & Search
                        </h6>
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                </div>
                <div class="collapse show" id="filtersCollapse">
                    <div class="card-body">
                        @await Html.PartialAsync("_PaymentFiltersPartial")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Statistics -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Payments</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-credit-card fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Paid</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Paid)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Pending)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Failed</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.Status == AseerAlkotb.Domain.Enums.PaymentStatus.Failed)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">COD</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.PaymentMethod == AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-left-dark shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">Online</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.PaymentMethod != AseerAlkotb.Domain.Enums.PaymentMethod.CashOnDelivery)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-globe fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">
                            <i class="fas fa-list me-2"></i>Payments List
                        </h6>
                        <div>
                            <button class="btn btn-sm btn-outline-primary" onclick="toggleBulkMode()">
                                <i class="fas fa-check-square me-1"></i>Bulk Actions
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="paymentsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th class="bulk-checkbox" style="display: none;">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                                    </th>
                                    <th>Payment ID</th>
                                    <th>Transaction ID</th>
                                    <th>Customer</th>
                                    <th>Order ID</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var payment in Model)
                                    {
                                        @await Html.PartialAsync("_PaymentRowPartial", payment)
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="fas fa-credit-card fa-3x mb-3"></i>
                                                <p class="mb-0">No payments found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Bulk Actions Panel -->
                    <div id="bulkActionsPanel" class="mt-3" style="display: none;">
                        <div class="card border-primary">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <span id="selectedCount">0</span> payments selected
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <select id="bulkStatusSelect" class="form-select d-inline-block w-auto me-2">
                                            <option value="">Select new status...</option>
                                            @foreach (var status in ViewBag.PaymentStatuses as AseerAlkotb.Domain.Enums.PaymentStatus[])
                                            {
                                                <option value="@((int)status)">@status</option>
                                            }
                                        </select>
                                        <button class="btn btn-primary" onclick="bulkUpdateStatus()">
                                            <i class="fas fa-save me-1"></i>Update Status
                                        </button>
                                        <button class="btn btn-secondary" onclick="toggleBulkMode()">
                                            <i class="fas fa-times me-1"></i>Cancel
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Payments pagination" class="mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize, search = ViewBag.SearchTerm, paymentStatus = ViewBag.SelectedPaymentStatus, paymentMethod = ViewBag.SelectedPaymentMethod, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, dateAscending = ViewBag.DateAscending })">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = ViewBag.PageSize, search = ViewBag.SearchTerm, paymentStatus = ViewBag.SelectedPaymentStatus, paymentMethod = ViewBag.SelectedPaymentMethod, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, dateAscending = ViewBag.DateAscending })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize, search = ViewBag.SearchTerm, paymentStatus = ViewBag.SelectedPaymentStatus, paymentMethod = ViewBag.SelectedPaymentMethod, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, dateAscending = ViewBag.DateAscending })">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusUpdateModal" tabindex="-1" aria-labelledby="statusUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusUpdateModalLabel">
                    <i class="fas fa-edit me-2"></i>Update Payment Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="statusUpdateForm">
                    <input type="hidden" id="paymentId" />
                    <div class="mb-3">
                        <label for="paymentInfo" class="form-label">Payment Information</label>
                        <p id="paymentInfo" class="form-control-plaintext text-muted"></p>
                    </div>
                    <div class="mb-3">
                        <label for="currentStatus" class="form-label">Current Status</label>
                        <p id="currentStatus" class="form-control-plaintext"></p>
                    </div>
                    <div class="mb-3">
                        <label for="newStatus" class="form-label">New Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="newStatus" required>
                            <option value="">Select new status...</option>
                            @foreach (var status in ViewBag.PaymentStatuses as AseerAlkotb.Domain.Enums.PaymentStatus[])
                            {
                                var statusValue = (int)status;
                                <option value="@statusValue">@status</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="adminNotes" class="form-label">Admin Notes</label>
                        <textarea class="form-control" id="adminNotes" rows="3" placeholder="Optional notes for this status change..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updatePaymentStatus()">
                    <i class="fas fa-save me-1"></i>Update Status
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payments.js"></script>
}